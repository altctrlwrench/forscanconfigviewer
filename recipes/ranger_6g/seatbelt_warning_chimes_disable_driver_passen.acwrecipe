title: Seatbelt Warning Chimes Disable (Driver & Passenger)
raw_community_title: Remove all seatbelt warnings and chimes (including OK button)
category: Chimes and Horn
platform: Ranger (6G)
model_years: 2024+
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: (2024+) 6G Ranger.xlsx
notes: See Forum spreadsheet for more info
steps:
- module: IPC
  address: 720-13-01
  mask: '**** **** ****'
  notes: Set all masked nibbles to 0 to disable seatbelt chimes and warning notifications.
  type: all_zeros
  target_state: All Seatbelt Warnings Disabled
  nibbles:
  - nibble: 0
    recommended_hex: '0'
