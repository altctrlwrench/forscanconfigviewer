title: Seatbelt Warning Chimes Disable (Driver & Passenger)
raw_community_title: ⚡ [Lightning] Seatbelt Warning Chimes Disable (Driver & Passenger)
category: Chimes and Horn
platform: F-150 Lightning
model_years: 2022-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Chimes and Horn] [Years: 2022-2026] [Original Title: Disable Seat
  Belt Reminder]

  Disables periodic audible Belt-Minder reminder. Can also be disabled per-seat via
  the Owner''s Manual procedure.'
steps:
- module: IPC
  address: 720-01-01
  targets:
  - mask: xxxx xx*x xx--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 2
      action: 0
      feature: Driver Beltminder (DB)
    - bit: 1
      action: 0
      feature: Pass BeltMinder (PBM)
    - bit: 0
      action: 0
      feature: Mid Pass Beltminder (MPB)
recipe_version: '1.1'
