title: Tire Size Calibration (PCM / BCM Circumference)
raw_community_title: Tire Size
category: Powertrain and Drivetrain
platform: Super Duty
model_years: 2023-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2023 Super Duty.xlsx
notes: Tire Size Calculator https://docs.google.com/spreadsheets/d/1EaVYjY7QC8iYAdsiYnSeJQ9SbyMEVSTYz0Kmb0at4Ps/edit?usp=sharing
steps:
- module: BDYCM-BCM
  address: 726-15-01
  mask: xxxx xxxx **--
  notes: 'User input required: Enter tire circumference in MM encoded in hex. Keep
    factory value unless calibrating new tire size.'
  type: continuous
  unit: mm
  feature_name: Tire Circumference (TC)
  instruction: Tire Size Calculator https://docs.google.com/spreadsheets/d/1EaVYjY7QC8iYAdsiYnSeJQ9SbyMEVSTYz0Kmb0at4Ps/edit?usp=sharing
  user_input: required
- module: ''
  address: 726-15-02
  mask: '**xx xx--'
  type: continuous
  unit: mm
  feature_name: Tire Circumference (TC)
  instruction: Tire Size Calculator https://docs.google.com/spreadsheets/d/1EaVYjY7QC8iYAdsiYnSeJQ9SbyMEVSTYz0Kmb0at4Ps/edit?usp=sharing
  user_input: required
  notes: 'User input required: Enter tire circumference in MM encoded in hex. Keep
