title: Engine Sound Enhancement (Fake Engine Noise) Disable
raw_community_title: 'Remove fake engine noise (STILL IN PROGRESS)


  NOTE: If you have the Technology package with 14 speaker B&O system, use code 2
  in the ACM, and Leave DSP as code D'
category: General
platform: Explorer
model_years: 2020-2026
trim: All
source_sheet: 2020-2024 Explorer.xlsx
notes: If first digit is 1, change to 0, this  will turn off ANC (active noise cancellation).
  use 2 to keep ANC enabled.
steps:
- module: ACM
  address: 727-01-01
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Engine Sound Enhancement (Fake Engine Noise) Disable
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Engine Sound Enhancement (Fake Engine Noise) Disable
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Engine Sound Enhancement (Fake Engine Noise) Disable
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: Engine Sound Enhancement (Fake Engine Noise) Disable
      target_state: Disabled
- module: DSP
  address: 783-01-01
  notes: Change 1st digit to C. Note:if your AS BUILT Is a D, leave it selected to
    keep ANC enabled.
  targets:
  - mask: '*xxx xxxx xx--'
    community_hex: C
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: Engine Sound Enhancement (Fake Engine Noise) Disable
      target_state: Disabled
recipe_version: '1.1'
