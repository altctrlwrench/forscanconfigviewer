title: Seatbelt Warning Chimes Disable (Driver & Passenger)
raw_community_title: Disable driver & passenger seatbelt minder
category: Chimes and Horn
platform: Bronco
model_years: 2021-2024
trim: Raptor / 12" Digital Cluster
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2022 Bronco.xlsx
notes: '0 = Disable both; 2 = Disable drivers; 4 = disable passenger

  Confirmed: LagoCJ/multi'
steps:
- module: IPC
  address: 720-01-01
  mask: xxxx xx*x xx--
  notes: '0 = Disable both; 2 = Disable drivers; 4 = disable passenger

    Confirmed: LagoCJ/multi'
  nibbles:
  - nibble: 6
    bits:
    - bit: 2
      action: 0
      feature_name: Driver Beltminder (DB)
      target_state: DB disabled
    - bit: 1
      action: 0
      feature_name: Pass BeltMinder (PBM)
      target_state: PBM disabled
    - bit: 0
      action: 0
      feature_name: Mid Pass Beltminder (MPB)
      target_state: MPB disabled
    notes: '0 = Disable both; 2 = Disable drivers; 4 = disable passenger

      Confirmed: LagoCJ/multi'
