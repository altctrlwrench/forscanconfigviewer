title: SecuriCode Door Pillar Keypad Enable
raw_community_title: Keypad Enable (wired keypad)
category: Locks and Security
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: See this post if you don't know the factory code https://www.f150forum.com/f129/forscan-14th-gen-f150s-481816/index67/#post6964982
steps:
- module: BCM
  address: 726-31-01
  notes: See this post if you don't know the factory code
  targets:
  - mask: xxxx xx*x xx--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: SecuriCode Door Pillar Keypad Enable
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: SecuriCode Door Pillar Keypad Enable
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: SecuriCode Door Pillar Keypad Enable
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: SecuriCode Door Pillar Keypad Enable
      target_state: Disabled
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: KeyPad_Enable_Cfg (KPEC)
      aliases:
      - KeyPad_Enable_Cfg
      target_state: KPEC DISABLE
      state_aliases:
      - Disable
    - bit: 0
      action: 1
      feature_name: KeyPad_Enable_Cfg (KPEC)
      aliases:
      - KeyPad_Enable_Cfg
      target_state: KPEC HW_INPUT
      state_aliases:
      - HW_Input
- module: APIM
  address: 7D0-01-02
  notes: optional - adds door keypad code to Sync settings use 6 if you have ambient
    lighting or 2 if you don't
  targets:
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: Door Keypad Code (DKC)
      target_state: DKC Available (Door Keypad menu button shall be displayed)
recipe_version: '1.1'
