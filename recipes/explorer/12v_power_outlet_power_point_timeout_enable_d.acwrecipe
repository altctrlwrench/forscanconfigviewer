title: 12V Power Outlet (Power Point) Timeout Enable/Disable
raw_community_title: Powerpoint Timeout disable
category: Convenience and Electrical
platform: Explorer
model_years: 2025-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2025-2026 Explorer.xlsx
notes: this will disable the timeout, be aware it will be constant powered and can
  deplete battery.
steps:
- module: BCM
  address: 726-57-01
  mask: xxxx x*xx
  nibble: 5
  recommended_hex: '0'
  bits:
  - bit: 3
    action: 0
    feature_name: Power_Point_Timeout_Cfg (PPTC)
    target_state: PPTC DISABLE
  - bit: 2
    action: 0
    feature_name: Power_Point_Timeout_Cfg (PPTC)
    target_state: PPTC DISABLE
  - bit: 1
    action: 0
    feature_name: Power_Point_Timeout_Cfg (PPTC)
    target_state: PPTC DISABLE
  - bit: 0
    action: 0
    feature_name: Power_Point_Timeout_Cfg (PPTC)
    target_state: PPTC DISABLE
