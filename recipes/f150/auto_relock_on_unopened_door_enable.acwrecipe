- module: BCM
  address: 726-27-01
  mask: xxxx xxxx x*--
  nibble: 9
  recommended_hex: '1'
  bits:
  - bit: 3
    action: 0
    feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
    target_state: AUTORELOCK DISABLE
  - bit: 2
    action: 0
    feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
    target_state: AUTORELOCK DISABLE
  - bit: 1
    action: 0
    feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
    target_state: AUTORELOCK DISABLE
  - bit: 0
    action: 1
    feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
    target_state: AUTORELOCK ENABLE
- module: BCM
  address: 726-58-02
  mask: xxx* xxxx xx--
  notes: 'Use this on 2021-23   duration: 1=30 seconds, 2=45 secs (target setting)
    | No data table'
  nibble: 3
  community_instruction: 'Use this on 2021-23   duration: 1=30 seconds, 2=45 secs
    (target setting) | No data table'
  bits:
  - bit: 3
    action: 0
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC NULL
  - bit: 2
    action: 0
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC NULL
  - bit: 1
    action: 1
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC AUTORELOCK_45SEC
  - bit: 0
    action: 0
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC NULL
- module: BCM
  address: 726-58-02
  mask: x*xx xxxx xx--
  notes: 'Use this on 2024-26   duration: 1=30 seconds, 2=45 secs (target setting)'
  nibble: 1
  community_instruction: 'Use this on 2024-26   duration: 1=30 seconds, 2=45 secs
    (target setting)'
  bits:
  - bit: 3
    action: 0
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC NULL
  - bit: 2
    action: 0
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC NULL
  - bit: 1
    action: 1
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC AUTORELOCK_45SEC
  - bit: 0
    action: 0
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC NULL
- module: APIM
  address: 7D0-09-01
  mask: xx*x xxxx xx--
  notes: optional - adds Autorelock to settings, vehicle, locks
  nibble: 2
  recommended_hex: '3'
  community_instruction: optional - adds Autorelock to settings, vehicle, locks
  bits:
  - bit: 3
    action: 1
    feature_name: Autolock Control Function (ACF)
    target_state: ACF Enabled
  - bit: 1
    action: 1
    feature_name: Auto Relock (AR)
    target_state: AR Enabled
