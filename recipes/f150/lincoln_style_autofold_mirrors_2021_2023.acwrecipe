title: Lincoln Style Autofold Mirrors
raw_community_title: (2021-2023) Mirrors - Lincoln Autofold
category: Windows and Mirrors
platform: F-150
model_years: 2021-2023
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: 'Link for explanation of regular autofold vs Lincoln autofold https://www.f150forum.com/f129/forscan-14th-gen-f150s-481816/index51/#post6947182

  Note: the tradeoff of using Lincoln Autofold is that puddle lights won''t work

  Reverse Tile also enabled'
steps:
- module: DDM
  address: 740-03-16
  notes: click here for an explanation of regular autofold vs Lincoln autofold
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 0
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
      feature: Mirror_Folding_Cfg
    - bit: 0
      action: 1
      feature: Mirror_Folding_Cfg
- module: PDM
  address: 741-03-16
  notes: 'Note: the tradeoff of using Lincoln Autofold is that puddle lights won''t
    work'
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 0
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
      feature: Mirror_Folding_Cfg
    - bit: 0
      action: 1
      feature: Mirror_Folding_Cfg
- module: APIM
  address: 7D0-09-01
  targets:
  - mask: xxxx xx*x xx--
    community_hex: A
    offset_hint: '+4'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature: Mirrors Autofold (MA)
    - bit: 2
      action: 1
      feature: Mirrors Reverse Tilt (MRT)
recipe_version: '1.1'
