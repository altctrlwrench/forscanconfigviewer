title: DRL - Low Beams and Parking Lights
raw_community_title: Low Beams & Parking Lamps as DRL (2024-2026) - see this post
  for pics
category: Lighting
platform: F-150
model_years: 2024-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: DRL_IncludeParklamps_Cfg https://www.f150forum.com/f129/forscan-14th-gen-f150s-481816/index330/#post7599368
steps:
- module: BCM
  address: 726-38-01
  notes: DRL_IncludeParklamps_Cfg
  targets:
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
      feature: DRL_IncludeParklamps_Cfg (DRLIPC)
- module: BCM
  address: 726-38-02
  notes: DRL_WithTurn_Cfg
  targets:
  - mask: xxx* xxxx xx--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
      feature: DRL_WithTurn_Cfg (DRLWTC)
    - bit: 0
      action: 0
      feature: DRL_WithTurn_Cfg (DRLWTC)
- module: BCM
  address: 726-41-02
  notes: LowBeam_Cfg
  targets:
  - mask: xxx* xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
      feature: LowBeam_Cfg (LBC)
- module: BCM
  address: 726-42-02
  notes: LF/RF_Low_Beam_Ckt_Usage_Cfg
  targets:
  - mask: xxx* xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
      feature: LF_Low_Beam_Ckt_Usage_Cfg (LFLBCUC)
    - bit: 0
      action: 1
      feature: LF_Low_Beam_Ckt_Usage_Cfg (LFLBCUC)
  - mask: xxxx x*xx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
      feature: RF_Low_Beam_Ckt_Usage_Cfg (RFLBCUC)
    - bit: 0
      action: 1
      feature: RF_Low_Beam_Ckt_Usage_Cfg (RFLBCUC)
- module: BCM
  address: 726-43-02
  notes: DRL_OnWithParkLampsOn_Cfg
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
      feature: DRL_OnWithParkLampsOn_Cfg (DRLOWPLOC)
recipe_version: '1.1'
