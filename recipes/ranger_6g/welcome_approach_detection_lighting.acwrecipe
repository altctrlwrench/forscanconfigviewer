title: Welcome & Approach Detection Lighting
raw_community_title: 'Welcome lights (approach detection)


  ** WARNING ** enabling this some have commented that the keyless touch entry is
  less sensitive to locking/unlocking the door'
category: Lighting
platform: Ranger (6G)
model_years: 2024+
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: (2024+) 6G Ranger.xlsx
steps:
- module: BCM
  address: 726-45-01
  mask: xxxx xxxx x*--
  nibble: 9
  community_instruction: '* -> 0=Disabled, 1=Enabled'
  feature_name: Approach_Lighting_Enable_Cfg (ALEC)
  target_state: ALEC DISABLE
  bit: 3
  action: 0
- module: BCM
  address: 726-18-01
  mask: xxxx xxxx x*--
  nibble: 9
  community_instruction: '* -> 0=Disabled, 1=Enabled'
  feature_name: Feat_Cfg [APPROACHDETECTION] [VEHICLE] (APPROACHDETECTION_VEHICLE)
  target_state: APPROACHDETECTION_VEHICLE DISABLE
  bit: 3
  action: 0
- module: APIM
  address: 7D0-09-01
  mask: xxx* xxxx xx--
  nibble: 3
  feature_name: Approach Detection Control Function (ADCF)
  target_state: ADCF Enabled
  bit: 2
  action: 1
