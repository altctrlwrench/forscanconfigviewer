title: Factory Trailer Brake Controller (TBC) Module Enable
raw_community_title: 2021-26 - Adding OEM Trailer Brake Controller
category: Powertrain and Drivetrain
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: use E for a turbo engine, use A for a 5.0L
steps:
- module: IPC
  address: 720-07-01
  notes: use E for a turbo engine, use A for a 5.0L
  targets:
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Trailer Brake Controller (TBC)
      target_state: TBC enabled
- module: BCM
  address: 726-69-02
  targets:
  - mask: xxxx x*xx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: TBM_Available_Cfg (TBMAC)
      aliases:
      - TBM_Available_Cfg
      target_state: TBMAC PRESENT
      state_aliases:
      - Present
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: TRM_Available_Cfg (TRMAC)
      aliases:
      - TRM_Available_Cfg
      target_state: TRMAC PRESENT
      state_aliases:
      - Present
- module: TRM
  address: 791-01-02
  notes: add 1 to current value (if 4 make 5, if 2 make 3)
  targets:
  - mask: xxxx x*xx xx--
    offset_hint: '+1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: TBM_Cfg (TBMC)
      target_state: TBMC PRESENT
- module: APIM
  address: 7D0-09-03
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '4'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature_name: Trailer Brake Controller (TBC)
      target_state: TBC Enabled
- module: IPMA
  address: 706-18-01
  targets:
  - mask: xxxx xxx* xx--
    community_hex: C
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: VehicleInfo_TrailerLightModule (VITLM)
      target_state: VITLM Present
    - bit: 2
      action: 1
      feature_name: VehicleInfo_TrailerBrakeModule (VITBM)
      aliases:
      - VehicleInfo_TrailerTowPresent (VITTP)
      target_state: VITBM Present
      state_aliases:
      - VITBM Not Present
recipe_version: '1.1'
