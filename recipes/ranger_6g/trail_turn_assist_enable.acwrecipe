title: Trail Turn Assist Enable
raw_community_title: Enables Trail Turn Assist
category: Powertrain and Drivetrain
platform: Ranger (6G)
model_years: 2024+
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'Confirmed: DIYPSCM (1/28/25) Lariat

  FORScan Menu: Trail Turn assist (Disabled (Default), Enabled)

  Confirmed: BigMeatsBronco (1/28/25) Raptor

  FORScan Menu: Off-road Menu - Trail turn Assist (Disabled (Default), Enabled)'
forscan_menu: Trail Turn assist (Disabled (Default), Enabled)
steps:
- module: ABS
  address: 760-03-01
  mask: xxxx *x--
  notes: 'Bit 4 (add 8 to enable)

    FORScan Menu: unknown, use asbuilt (advanced) (Not available - use asbuilt)

    Confirmed: DIYPSCM (1/28/25) Lariat'
  community_instruction: 'Bit 4 (add 8 to enable)

    FORScan Menu: unknown, use asbuilt (advanced) (Not available - use asbuilt)

    Confirmed: DIYPSCM (1/28/25) Lariat'
  nibbles:
  - nibble: 4
    bits:
    - bit: 3
      action: 1
      feature_name: TTA (TTA)
      target_state: Enabled
    hex_offset: '+8'
    notes: 'Bit 4 (add 8 to enable)

      FORScan Menu: unknown, use asbuilt (advanced) (Not available - use asbuilt)

      Confirmed: DIYPSCM (1/28/25) Lariat'
- module: APIM
  address: 7D0-02-01
  mask: xxx* xxxx xx--
  notes: 'Bit 1 (add 1 to enable)

    FORScan Menu: Trail Turn assist (Disabled (Default), Enabled)

    Confirmed: BigMeatsBronco (1/28/25) Raptor'
  nibbles:
  - nibble: 3
    bits:
    - bit: 0
      action: 1
      feature_name: Trail Turn Assist (TTA)
      target_state: TTA Enabled
    hex_offset: '+1'
    notes: 'Bit 1 (add 1 to enable)

      FORScan Menu: Trail Turn assist (Disabled (Default), Enabled)

      Confirmed: BigMeatsBronco (1/28/25) Raptor'
- module: APIM
  address: 7D0-10-02
  mask: xxxx xxx* xx--
  notes: 'Bit 3 (add 4 to enable)

    FORScan Menu: Off-road Menu - Trail turn Assist (Disabled (Default), Enabled)'
  nibbles:
  - nibble: 7
    bits:
    - bit: 2
      action: 1
      feature_name: Offroad Menu Trail Turn Assist (OMTTA)
      target_state: OMTTA Present
    hex_offset: '+4'
    notes: 'Bit 3 (add 4 to enable)

      FORScan Menu: Off-road Menu - Trail turn Assist (Disabled (Default), Enabled)'
