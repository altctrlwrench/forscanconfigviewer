title: Sync Vehicle Maintenance Oil Life Screen Enable
raw_community_title: Enable Oil Life in Sync Settings, Vehicle
category: Sync and Infotainment
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
steps:
- module: APIM
  address: 7D0-10-01
  targets:
  - mask: x*xx xxxx xx--
    community_hex: '8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Oil Life  (OL)
      aliases:
      - Oil Life (OL)
      target_state: OL Enabled
recipe_version: '1.1'
