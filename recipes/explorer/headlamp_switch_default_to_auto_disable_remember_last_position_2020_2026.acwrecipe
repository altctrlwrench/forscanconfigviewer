title: Headlamp Switch Default to Auto Disable (Remember Last Position)
raw_community_title: Prevent headlamp from defaulting to "Auto" position
category: Lighting
platform: Explorer
model_years: 2020-2026
trim: All
source_sheet: 2020-2024 Explorer.xlsx
notes: Headlamp will revert to last position at startup
steps:
- module: BCM
  address: 726-74-01
  targets:
  - mask: xx*x xxxx xx--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Headlamp Switch Default to Auto Disable (Remember Last Position)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Headlamp Switch Default to Auto Disable (Remember Last Position)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Headlamp Switch Default to Auto Disable (Remember Last Position)
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: Headlamp Switch Default to Auto Disable (Remember Last Position)
      target_state: Disabled
  - mask: xxx* xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: HeadlampPosAtIgnOn_Cfg (HPAIOC)
      target_state: HPAIOC LAST_KNOWN
recipe_version: '1.1'
