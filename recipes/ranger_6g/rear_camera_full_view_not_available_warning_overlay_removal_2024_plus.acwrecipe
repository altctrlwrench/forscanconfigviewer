title: Rear Camera 'Full View Not Available' Warning Overlay Removal
raw_community_title: Removes black box on reverse camera that says "full view not
  available
category: Cameras and ADAS
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'FORScan Menu: unknown, use asbuilt (advanced)

  Confirmed: craigc (9/12/2024) Lariat'
steps:
- module: APIM
  address: 7D0-02-02
  notes: '* Bit 1 (add 1 to enable, e.g. change 2 to 3)

    FORScan Menu: unknown, use asbuilt (advanced)

    Confirmed: craigc (9/12/2024) Lariat'
  targets:
  - mask: xxx* xxxx xx--
    offset_hint: '+1'
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: Rear Camera 'Full View Not Available' Warning Overlay Removal
      aliases:
      - RCOD HMI w/o Blackbox (RCODHMIB)
      target_state: Disabled
recipe_version: '1.1'
