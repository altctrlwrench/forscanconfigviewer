title: BlueCruise 1.4 Feature Set (Lane Biasing & Curve Speed)
raw_community_title: Bluecruise 1.4 Settings   (IPMA strategy must be on ACJ or BBC
  for this to work)
category: Cameras and ADAS
platform: F-150
model_years: 2021-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
notes: Lane Biasing (Under Cruise Control), Predictive Speed Assist (Under Cruise
  Control)
steps:
- module: APIM
  address: 7D0-09-05
  mask: xxxx xx*x *x--
  notes: Lane Biasing (Under Cruise Control), Predictive Speed Assist (Under Cruise
    Control)
  nibbles:
  - nibble: 6
    recommended_hex: '4'
    notes: Lane Biasing (Under Cruise Control), Predictive Speed Assist (Under Cruise
      Control) | No Data Table
    feature_name: Lane Biasing (LB)
    target_state: LB Enabled
    bit: 2
    action: 1
  - nibble: 8
    recommended_hex: '2'
    notes: Lane Biasing (Under Cruise Control), Predictive Speed Assist (Under Cruise
      Control) | No Data Table
    bits:
    - bit: 2
      action: 1
      feature_name: Curve Speed Control Menu (CSCM)
      target_state: CSCM Enabled
    - bit: 1
      action: 1
      feature_name: Predictive Speed Assist (PSA)
      target_state: PSA Enabled
- module: APIM
  address: 7D0-10-02
  mask: xxxx xxxx *x--
  notes: Lane Change Assist (under Cruise Control)
  community_instruction: Lane Change Assist (under Cruise Control)
  nibbles:
  - nibble: 8
    bits:
    - bit: 0
      action: 1
      feature_name: Assisted Lane Change  (ALC)
      target_state: ALC Enabled
    recommended_hex: '1'
    notes: Lane Change Assist (under Cruise Control)
- module: IPMA
  address: 706-01-01
  mask: x*xx xxxx xx--
  notes: MFCLKS LKAlert+LKAid+LCWA
  nibbles:
  - nibble: 1
    bits:
    - bit: 3
      action: 1
      feature_name: ModuleFeatureCfg_LKS (MFCLKS)
      target_state: MFCLKS LKAlert+LKAid
    - bit: 2
      action: 1
      feature_name: ModuleFeatureCfg_LKS (MFCLKS)
      target_state: MFCLKS LKAlert
    - bit: 1
      action: 1
      feature_name: ModuleFeatureCfg_DAS (MFCDAS)
      target_state: MFCDAS Enabled
    - bit: 0
      action: 0
      feature_name: ModuleFeatureCfg_LKS (MFCLKS)
    recommended_hex: E
    notes: MFCLKS LKAlert+LKAid+LCWA
- module: IPMA
  address: 706-01-02
  mask: x*xx xxxx xx--
  notes: ModuleFeatureCfg_ALB (MFCALB)&ModuleFeatureCfg_ALC (MFCALC) | No Data Table
  nibbles:
  - nibble: 1
    bits:
    - bit: 2
      action: 1
      feature_name: ModuleFeatureCfg_ALB (MFCALB)
      target_state: MFCALB Enabled
    - bit: 0
      action: 1
      feature_name: ModuleFeatureCfg_ALC (MFCALC)
      target_state: MFCALC Enabled
    recommended_hex: '5'
    notes: ModuleFeatureCfg_ALB (MFCALB)&ModuleFeatureCfg_ALC (MFCALC) | No Data Table
- module: IPMA
  address: 706-02-02
  mask: xxxx xxxx x*--
  notes: FeatureCfg_IACCMode (FCIACCM) FCIACCM Preview+CurveControl
  nibbles:
  - nibble: 9
    recommended_hex: '2'
    feature_name: FeatureCfg_IACCMode (FCIACCM)
    target_state: Preview + CurveControl
    bits:
    - bit: 1
      action: 1
      feature_name: FeatureCfg_IACCMode (FCIACCM)
      target_state: Preview + CurveControl
- module: IPMA
  address: 706-38-01
  mask: x*x* xxxx xx--
  notes: CustomerSetting_ALBSelected_Vehicle (CSALBSV),  CustomerSetting_ALCSelected_Vehicle
    (CSALCSV)
  nibbles:
  - nibble: 1
    recommended_hex: '8'
    notes: CustomerSetting_ALBSelected_Vehicle (CSALBSV),  CustomerSetting_ALCSelected_Vehicle
      (CSALCSV) | No Data Table
    community_instruction: CustomerSetting_ALBSelected_Vehicle (CSALBSV),  CustomerSetting_ALCSelected_Vehicle
      (CSALCSV) | No Data Table
    bits:
    - bit: 3
      action: 1
      feature_name: CustomerSetting_ALBSelected_Vehicle (CSALBSV)
      target_state: CSALBSV On
    - bit: 2
      action: 0
      feature_name: CustomerSetting_ALBSelected_Vehicle (CSALBSV)
      target_state: CSALBSV Off
    - bit: 1
      action: 0
      feature_name: CustomerSetting_ALBSelected_Vehicle (CSALBSV)
      target_state: CSALBSV Off
    - bit: 0
      action: 0
      feature_name: CustomerSetting_ALBSelected_Vehicle (CSALBSV)
      target_state: CSALBSV Off
  - nibble: 3
    recommended_hex: '8'
    notes: CustomerSetting_ALBSelected_Vehicle (CSALBSV),  CustomerSetting_ALCSelected_Vehicle
      (CSALCSV)
    community_instruction: CustomerSetting_ALBSelected_Vehicle (CSALBSV),  CustomerSetting_ALCSelected_Vehicle
      (CSALCSV)
    bits:
    - bit: 3
      action: 1
      feature_name: CustomerSetting_ALCSelected_Vehicle (CSALCSV)
      target_state: CSALCSV On
    - bit: 2
      action: 0
      feature_name: CustomerSetting_ALCSelected_Vehicle (CSALCSV)
      target_state: CSALCSV Off
    - bit: 1
      action: 0
      feature_name: CustomerSetting_ALCSelected_Vehicle (CSALCSV)
      target_state: CSALCSV Off
    - bit: 0
