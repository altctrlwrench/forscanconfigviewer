title: Lincoln Style Autofold Mirrors
raw_community_title: ⚡ [Lightning] Lincoln Style Autofold Mirrors
category: Windows and Mirrors
platform: F-150 Lightning
model_years: 2022-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Windows and Mirrors] [Years: 2022-2023] [Original Title: Lincoln
  Folding Mirrors Setting]

  Folds when locked, but unfolds only when driver door closes instead of when unlocked.
  Known issue: puddle lights get disabled.'
steps:
- module: DDM
  address: 740-03-16
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 0
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
      feature: Mirror_Folding_Cfg
    - bit: 0
      action: 1
      feature: Mirror_Folding_Cfg
- module: PDM
  address: 741-03-16
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 0
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
      feature: Mirror_Folding_Cfg
    - bit: 0
      action: 1
      feature: Mirror_Folding_Cfg
recipe_version: '1.1'
