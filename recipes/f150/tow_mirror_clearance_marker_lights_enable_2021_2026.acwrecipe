title: Tow Mirror Clearance Marker Lights Enable
raw_community_title: 2021-26 Enabling marker lights on tow mirrors upgrade
category: Lighting
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
steps:
- module: BCM
  address: 726-40-01
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: Park_Lamps_Body_Ckt_Usage_Cfg (PLBCUC)
      aliases:
      - Park_Lamps_Body_Ckt_Usage_Cfg
      target_state: PLBCUC POSITION_ONLY
      state_aliases:
      - Not Used
    - bit: 0
      action: 1
      feature_name: Park_Lamps_Body_Ckt_Usage_Cfg (PLBCUC)
      aliases:
      - Park_Lamps_Body_Ckt_Usage_Cfg
      target_state: PLBCUC POSITION_ONLY
      state_aliases:
      - Position Only
recipe_version: '1.1'
