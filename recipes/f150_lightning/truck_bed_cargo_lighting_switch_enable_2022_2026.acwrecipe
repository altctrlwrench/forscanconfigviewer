title: Truck Bed Cargo Lighting Switch Enable
raw_community_title: 2021-23 Enabling Bed Lights/Switch (Lightning Specific)
category: Lighting
platform: F-150 Lightning
model_years: 2022-2026
trim: All
validated: true
validation_status: validated
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx (BCM 21-23 Lightning)
notes: 'Enables the physical bed cargo light switch in the truck bed for F-150 Lightning
  using Group D BCM pinout. (Note: 726-50-02 bed lamp illumination is omitted as it
  is not used on Lightning).'
steps:
- module: BCM
  address: 726-81-01
  mask: x*x* xxxx xx--
  nibbles:
  - nibble: 1
    recommended_hex: '2'
    notes: BCM (21-23 Lightning) Group D
    bits:
    - bit: 3
      action: 0
      feature_name: Feat360_FlashOffTime_Cfg (FFOTC)
      target_state: Disable
    - bit: 2
      action: 0
      feature_name: Feat360_FlashOffTime_Cfg (FFOTC)
      target_state: Disable
    - bit: 1
      action: 1
      feature_name: Feat360_FlashOffTime_Cfg (FFOTC)
      target_state: Enable Bed Switch
    - bit: 0
      action: 0
      feature_name: Feat360_FlashOffTime_Cfg (FFOTC)
      target_state: Disable
  - nibble: 3
    recommended_hex: '1'
    notes: BCM (21-23 Lightning) Group D
    bits:
    - bit: 3
      action: 0
      feature_name: Feat360_FlashOffTime_Cfg (FFOTC)
      target_state: Disable
    - bit: 2
      action: 0
      feature_name: Feat360_FlashOffTime_Cfg (FFOTC)
      target_state: Disable
    - bit: 1
      action: 0
      feature_name: Feat360_FlashOffTime_Cfg (FFOTC)
      target_state: Disable
    - bit: 0
      action: 1
      feature_name: Feat360_FlashOffTime_Cfg (FFOTC)
      target_state: Enable Switch Illumination
