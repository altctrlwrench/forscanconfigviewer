title: Keyfob Panic Button Activation Mode
raw_community_title: Keyfob Panic Button
category: Locks and Security
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'FORScan Menu: Panic Activate (Change Pulse Click to Double Click)

  Trim: All? [Confirmed: craigc (9/10/2024) Lariat FX4]'
steps:
- module: BCM
  address: 726-62-01
  notes: '* -> 0=disabled, 1=2 clicks, 2=one click (default)

    FORScan Menu: Panic Activate (Change Pulse Click to Double Click)

    Trim: All? [Confirmed: craigc (9/10/2024) Lariat FX4]'
  targets:
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: PanicActivate_Cfg (PAC)
      target_state: PAC DISABLE
    - bit: 0
      action: 1
      feature_name: PanicActivate_Cfg (PAC)
      target_state: PAC DOUBLE
recipe_version: '1.1'
