title: Global Windows Remote Open/Close Enable
raw_community_title: "(2021-2023) Global Windows Open/Close \n(driver/pass windows\
  \ only)"
category: Windows and Mirrors
platform: F-150
model_years: 2021-2023
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
notes: 'Optional: to add Global Open/Close to Sync 4 Settings menu set this in APIM:
  7D0-09-01- xxxx xExx xx--'''
steps:
- module: DDM
  address: 740-06-02
  mask: xxxx xxxx **--
  notes: 'Optional: to add Global Open/Close to Sync 4 Settings menu set this in APIM:
    7D0-09-01- xxxx xExx xx--'
  nibbles:
  - nibble: 8
    recommended_hex: '0'
    notes: 'Optional: to add Global Open/Close to Sync 4 Settings menu set this in
      APIM: 7D0-09-01- xxxx xExx xx--'
    community_instruction: 'Optional: to add Global Open/Close to Sync 4 Settings
      menu set this in APIM: 7D0-09-01- xxxx xExx xx--'
    bits:
    - bit: 3
      action: 0
      feature_name: Global Close
      target_state: disabled,
    - bit: 2
      action: 0
      feature_name: Global Close
      target_state: disabled,
    - bit: 1
      action: 0
      feature_name: Global Close
      target_state: disabled,
    - bit: 0
      action: 1
      feature_name: Global Close
      target_state: disabled,
  - nibble: 9
    recommended_hex: '1'
    notes: 'Optional: to add Global Open/Close to Sync 4 Settings menu set this in
      APIM: 7D0-09-01- xxxx xExx xx-- | Note, hex sets global CLOSE | Not hex sets
      global OPEN'
    community_instruction: 'Optional: to add Global Open/Close to Sync 4 Settings
      menu set this in APIM: 7D0-09-01- xxxx xExx xx-- | Note, hex sets global CLOSE
      | Not hex sets global OPEN'
    bits:
    - bit: 3
      action: 0
      feature_name: Global Close
      target_state: disabled,
    - bit: 2
      action: 0
      feature_name: Global Close
      target_state: disabled,
    - bit: 1
      action: 0
      feature_name: Global Close
      target_state: disabled,
    - bit: 0
      action: 1
      feature_name: Global Close
      target_state: disabled,
