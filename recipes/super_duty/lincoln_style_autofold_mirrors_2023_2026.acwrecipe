title: Lincoln Style Autofold Mirrors
raw_community_title: Autofold Mirror Lincoln Style
category: Windows and Mirrors
platform: Super Duty
model_years: 2023-2026
trim: All
source_sheet: 2023-2026 Super Duty Common Items.xlsx
notes: 0=Disabled  1 Enabled  Folding Mirror at door close.  Does not open at unlock.
  (Disables Puddle Lights)
steps:
- module: DDM
  address: 740-03-16
  notes: 0=Disabled  1 Enabled  Folding Mirror at door close.  Does not open at unlock.
    (Disables Puddle Lights)
  targets:
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: Mirror_Folding_Cfg (MFC)
      aliases:
      - Mirror_Folding_Cfg
      target_state: MFC AUTOFOLD_1/auto foldable mirror for non-lincoln vehicles
      state_aliases:
      - Ford,
    - bit: 0
      action: 1
      feature_name: Mirror_Folding_Cfg (MFC)
      aliases:
      - Mirror_Folding_Cfg
      target_state: MFC AUTOFOLD_2/auto foldable mirror for lincoln vehicles
      state_aliases:
      - Lincoln,
- module: PDM
  address: 741-03-16
  notes: 0=Disabled  1 Enabled  Folding Mirror at door close.  Does not open at unlock.
    (Disables Puddle Lights)
  targets:
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: Mirror_Folding_Cfg (MFC)
      aliases:
      - Mirror_Folding_Cfg
      target_state: MFC AUTOFOLD_1/auto foldable mirror for non-lincoln vehicles
      state_aliases:
      - Ford,
    - bit: 0
      action: 1
      feature_name: Mirror_Folding_Cfg (MFC)
      aliases:
      - Mirror_Folding_Cfg
      target_state: MFC AUTOFOLD_2/auto foldable mirror for lincoln vehicles
      state_aliases:
      - Lincoln,
recipe_version: '1.1'
