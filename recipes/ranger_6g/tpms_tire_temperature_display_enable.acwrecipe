title: TPMS Tire Temperature Display Enable
raw_community_title: TPMS - Display tire temperature in addition to tire pressure
category: Cluster and Displays
platform: Ranger (6G)
model_years: 2024+
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'Can use FORScan Easy Mode

  FORScan Menu: Tire Temperature Display (Disabled (Default), Enabled)

  Trim: All [Confirmed: jezzzza (9/12/2024) Raptor]'
forscan_menu: Tire Temperature Display (Disabled (Default), Enabled)
steps:
- module: IPC
  address: 720-11-01
  mask: xxxx *xxx xx--
  notes: Bit 4 (Add 8 to enable, e.g. change 2 to A)
  community_instruction: Bit 4 (Add 8 to enable, e.g. change 2 to A)
  nibbles:
  - nibble: 4
    bits:
    - bit: 3
      action: 1
      feature_name: Tire Temperature Display (TTD)
      target_state: TTD Enabled
    hex_offset: '+8'
    notes: Bit 4 (Add 8 to enable, e.g. change 2 to A)
