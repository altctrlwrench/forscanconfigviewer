title: Rear Camera 'Full View Not Available' Warning Overlay Removal
raw_community_title: 'Removes "Full View Not Available" message in rear camera view.


  (Allows cams in motion at any speed without black box in middle)'
category: General
platform: Explorer
model_years: 2020-2026
trim: All
source_sheet: 2020-2024 Explorer.xlsx
notes: negated
steps:
- module: APIM
  address: 7D0-02-02
  notes: 'If your current value is 0 then change to 1, 2 change to 3, 4 change to
    5, 6 change to 7


    Note: reset APIM after the change'
  targets:
  - mask: xxx* xxxx xx--
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: RCOD HMI w/o Blackbox (RCODHMIB)
      target_state: Enabled
recipe_version: '1.1'
