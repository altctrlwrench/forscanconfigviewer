title: DRL - Amber Turn Signal Rings Only
raw_community_title: Sets DRL to amber turrns only (DRL in amber LED bars)
category: Lighting
platform: Explorer
model_years: 2020-2024
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2020-2024 Explorer.xlsx
notes: 'Sets the White DRL to fixed position (off when the car is in normal drive
  mode during daytime)

  Sets Turn to Turn and DRL'
steps:
- module: BCM
  address: 726-42-01
  mask: x*x* xxxx xx--
  notes: Sets the White DRL to fixed position (off when the car is in normal drive
    mode during daytime)
  nibbles:
  - nibble: 1
    recommended_hex: '4'
    notes: Sets the White DRL to fixed position (off when the car is in normal drive
      mode during daytime)
    community_instruction: Sets the White DRL to fixed position (off when the car
      is in normal drive mode during daytime)
    bits:
    - bit: 3
      action: 0
      feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
      target_state: LFDRLLCUC NOT_USED
    - bit: 2
      action: 1
      feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
      target_state: LFDRLLCUC FIXED_POSITION_ONLY
    - bit: 1
      action: 0
      feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
      target_state: LFDRLLCUC NOT_USED
    - bit: 0
      action: 0
      feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
      target_state: LFDRLLCUC NOT_USED
  - nibble: 3
    recommended_hex: '4'
    notes: Sets the White DRL to fixed position (off when the car is in normal drive
      mode during daytime)
    community_instruction: Sets the White DRL to fixed position (off when the car
      is in normal drive mode during daytime)
    bits:
    - bit: 3
      action: 0
      feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
      target_state: RFDRLLCUC NOT_USED
    - bit: 2
      action: 1
      feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
      target_state: RFDRLLCUC FIXED_POSITION_ONLY
    - bit: 1
      action: 0
      feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
      target_state: RFDRLLCUC NOT_USED
    - bit: 0
      action: 0
      feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
      target_state: RFDRLLCUC NOT_USED
- module: BCM
  address: 726-43-01
  mask: x*x* xxxx xx--
  notes: Sets Turn to Turn and DRL
  nibbles:
  - nibble: 1
    recommended_hex: '1'
    notes: Sets Turn to Turn and DRL
    community_instruction: Sets Turn to Turn and DRL
    bits:
    - bit: 3
      action: 0
      feature_name: LF_Turn_Lamp_Ckt_Usage_Cfg (LFTLCUC)
      target_state: LFTLCUC NOT_USED
    - bit: 2
      action: 0
      feature_name: LF_Turn_Lamp_Ckt_Usage_Cfg (LFTLCUC)
      target_state: LFTLCUC NOT_USED
    - bit: 1
      action: 0
      feature_name: LF_Turn_Lamp_Ckt_Usage_Cfg (LFTLCUC)
      target_state: LFTLCUC NOT_USED
    - bit: 0
      action: 1
      feature_name: LF_Turn_Lamp_Ckt_Usage_Cfg (LFTLCUC)
      target_state: LFTLCUC TURN_POSITION
  - nibble: 3
    recommended_hex: '1'
    notes: Sets Turn to Turn and DRL
    community_instruction: Sets Turn to Turn and DRL
    bits:
    - bit: 3
      action: 0
      feature_name: RF_Turn_Lamp_Ckt_Usage_Cfg (RFTLCUC)
      target_state: RFTLCUC NOT_USED
    - bit: 2
      action: 0
      feature_name: RF_Turn_Lamp_Ckt_Usage_Cfg (RFTLCUC)
      target_state: RFTLCUC NOT_USED
    - bit: 1
      action: 0
      feature_name: RF_Turn_Lamp_Ckt_Usage_Cfg (RFTLCUC)
      target_state: RFTLCUC NOT_USED
    - bit: 0
      action: 1
      feature_name: RF_Turn_Lamp_Ckt_Usage_Cfg (RFTLCUC)
      target_state: RFTLCUC TURN_POSITION
