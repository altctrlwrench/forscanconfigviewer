title: Auto Relock on Unopened Door Enable
raw_community_title: Auto Relock - if you hit the unlock button on the fob and do
  not open a door within the timer it will lock the truck
category: Locks and Security
platform: Mustang
model_years: 2024+
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2024 Mustang Darkhorse (public).xlsx
notes: '*= 1 for 30 seconds, 2 for 45 seconds

  optional - adds Autorelock to settings, vehicle, locks'
steps:
- module: BCM
  address: 726-20-01
  mask: x*x* x*x* x*--
  nibbles:
  - nibble: 1
    recommended_hex: '1'
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_1] (AUTORELOCK_PERS_1)
      target_state: AUTORELOCK_PERS_1 DISABLE
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_1] (AUTORELOCK_PERS_1)
      target_state: AUTORELOCK_PERS_1 DISABLE
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_1] (AUTORELOCK_PERS_1)
      target_state: AUTORELOCK_PERS_1 DISABLE
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_1] (AUTORELOCK_PERS_1)
      target_state: AUTORELOCK_PERS_1 ENABLE
  - nibble: 3
    recommended_hex: '1'
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_2] (AUTORELOCK_PERS_2)
      target_state: AUTORELOCK_PERS_2 DISABLE
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_2] (AUTORELOCK_PERS_2)
      target_state: AUTORELOCK_PERS_2 DISABLE
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_2] (AUTORELOCK_PERS_2)
      target_state: AUTORELOCK_PERS_2 DISABLE
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_2] (AUTORELOCK_PERS_2)
      target_state: AUTORELOCK_PERS_2 ENABLE
  - nibble: 5
    recommended_hex: '1'
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_3] (AUTORELOCK_PERS_3)
      target_state: AUTORELOCK_PERS_3 DISABLE
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_3] (AUTORELOCK_PERS_3)
      target_state: AUTORELOCK_PERS_3 DISABLE
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_3] (AUTORELOCK_PERS_3)
      target_state: AUTORELOCK_PERS_3 DISABLE
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_3] (AUTORELOCK_PERS_3)
      target_state: AUTORELOCK_PERS_3 ENABLE
  - nibble: 7
    recommended_hex: '1'
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_4] (AUTORELOCK_PERS_4)
      target_state: AUTORELOCK_PERS_4 DISABLE
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_4] (AUTORELOCK_PERS_4)
      target_state: AUTORELOCK_PERS_4 DISABLE
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_4] (AUTORELOCK_PERS_4)
      target_state: AUTORELOCK_PERS_4 DISABLE
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_4] (AUTORELOCK_PERS_4)
      target_state: AUTORELOCK_PERS_4 ENABLE
  - nibble: 9
    recommended_hex: '1'
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [VEHICLE] (AUTORELOCK_VEHICLE)
      target_state: AUTORELOCK_VEHICLE DISABLE
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [VEHICLE] (AUTORELOCK_VEHICLE)
      target_state: AUTORELOCK_VEHICLE DISABLE
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [VEHICLE] (AUTORELOCK_VEHICLE)
      target_state: AUTORELOCK_VEHICLE DISABLE
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [AUTORELOCK] [VEHICLE] (AUTORELOCK_VEHICLE)
      target_state: AUTORELOCK_VEHICLE ENABLE
- module: BCM
  address: 726-27-01
  mask: xxxx xxxx x*--
  nibble: 9
  recommended_hex: '1'
  bits:
  - bit: 3
    action: 0
    feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
    target_state: AUTORELOCK DISABLE
  - bit: 2
    action: 0
    feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
    target_state: AUTORELOCK DISABLE
  - bit: 1
    action: 0
    feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
    target_state: AUTORELOCK DISABLE
  - bit: 0
    action: 1
    feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
    target_state: AUTORELOCK ENABLE
- module: BCM
  address: 726-58-02
  mask: xxx* xxxx xx--
  notes: '*= 1 for 30 seconds, 2 for 45 seconds'
  nibble: 3
  bits:
  - bit: 3
    action: 0
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC NULL
  - bit: 2
    action: 0
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC NULL
  - bit: 1
    action: 1
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC AUTORELOCK_45SEC
  - bit: 0
    action: 0
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    target_state: ARTC NULL
- module: APIM
  address: 7D0-09-01
  mask: xx*x xxxx xx--
  notes: optional - adds Autorelock to settings, vehicle, locks
  nibble: 2
  recommended_hex: '2'
  community_instruction: optional - adds Autorelock to settings, vehicle, locks
  feature_name: Auto Relock (AR)
  target_state: AR Enabled
  bit: 1
  action: 1
