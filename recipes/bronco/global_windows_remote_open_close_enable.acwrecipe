      action: 0
      feature_name: DebugCANmessages_Cfg (DCANC)
      target_state: DCANC NOT_AVAILABLE
    - bit: 2
      action: 0
      feature_name: DebugCANmessages_Cfg (DCANC)
      target_state: DCANC NOT_AVAILABLE
