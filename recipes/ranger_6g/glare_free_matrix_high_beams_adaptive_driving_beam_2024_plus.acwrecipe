- module: APIM
  address: 7D0-09-01
  notes: '* -> 1=GFHB, 3=OEM (Default)

    Trim: Lariat/Raptor [Confirmed: moproblems (12/31/24)]'
  targets:
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: Auto High Beam Control Function (AHBCF)
      target_state: AHBCF Disabled
    - bit: 0
      action: 1
      feature_name: Autolamp Delay (AD)
      target_state: AD Enabled
- module: APIM
  address: 7D0-09-03
  notes: '* -> 8=GFHB, 4=OEM (Default)

    Trim: Lariat/Raptor [Confirmed: moproblems (12/31/24)]'
  targets:
  - mask: xx*x xxxx xx--
    type: discrete
    bits:
    - bit: 3
      action: 1
