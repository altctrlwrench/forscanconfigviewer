source_sheet: 2025-2026 Explorer.xlsx
notes: 0=Disabled, 1=Enabled (2 press), 2=Enabled (1 press)
steps:
- module: BCM
  address: 726-62-01
  mask: x*xx xxxx xx--
  nibble: 1
  notes: 0=Disabled, 1=Enabled (2 press), 2=Enabled (1 press)
  community_instruction: 0=Disabled, 1=Enabled (2 press), 2=Enabled (1 press)
  bits:
  - bit: 3
    action: 0
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DISABLE
  - bit: 2
    action: 0
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DISABLE
  - bit: 1
    action: 0
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DISABLE
  - bit: 0
    action: 1
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DOUBLE
- module: BCM
  address: 726-01-02
  mask: xxxx xxx* xx--
  notes: 0=Lights and Horn, 1=Horn only
  nibble: 7
  bits:
  - bit: 3
    action: 0
    feature_name: PanicAlarm_Cfg (PAC)
    target_state: PAC BOTH
  - bit: 2
    action: 0
    feature_name: PanicAlarm_Cfg (PAC)
    target_state: PAC BOTH
  - bit: 1
    action: 0
    feature_name: PanicAlarm_Cfg (PAC)
    target_state: PAC BOTH
  - bit: 0
    action: 0
    feature_name: PanicAlarm_Cfg (PAC)
