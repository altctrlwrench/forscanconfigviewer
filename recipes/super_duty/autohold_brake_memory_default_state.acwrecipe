title: AutoHold Brake Memory / Default State
raw_community_title: AutoHold
category: Powertrain and Drivetrain
platform: Super Duty
model_years: 2023-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2023 Super Duty.xlsx
notes: 'Add 1 to current value

  Add 4 to current value'
steps:
- module: ABS
  address: 760-03-01
  mask: '*xxx xxxx xx--'
  notes: Add 1 to current value
  nibbles:
  - nibble: 0
    bits:
    - bit: 3
      action: 0
      feature_name: Reserved  (R)
    - bit: 2
      action: 0
      feature_name: Reserved  (R)
    - bit: 0
      action: 1
      feature_name: Autohold  (A)
      target_state: A With Autohold [Standard Equipment]
    hex_offset: '+4'
    notes: Add 1 to current value
- module: APIM
  address: 7D0-01-03
  mask: xx*x xxxx xx--
  notes: Add 4 to current value
  nibbles:
  - nibble: 2
    bits:
    - bit: 2
      action: 1
      feature_name: Auto Hold (AH)
      target_state: AH Enabled
    hex_offset: '+4'
    notes: Add 4 to current value
- module: IPC
  address: 720-02-01
  mask: xxxx x*xx xx--
  notes: Add 1 to current value
  nibbles:
  - nibble: 5
    bits:
    - bit: 0
      action: 1
      feature_name: AutoHold (AH)
      target_state: AH enabled
    hex_offset: '+4'
    notes: Add 1 to current value
