title: Truck Bed Cargo Lighting Switch Enable
raw_community_title: ⚡ [Lightning] Truck Bed Cargo Lighting Switch Enable
category: Lighting
platform: F-150 Lightning
model_years: 2022-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Lighting] [Years: 2022-2026] [Original Title: 2021-23 Enabling
  Bed Lights/Switch (Lightning Specific)]

  Enables the physical bed cargo light switch in the truck bed for F-150 Lightning
  using Group D BCM pinout. (Note: 726-50-02 bed lamp illumination is omitted as it
  is not used on Lightning).'
steps:
- module: BCM
  address: 726-81-01
  targets:
  - mask: x*xx xxxx xx--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: Ext_Courtesy_Sw_Input_Cfg (ECSIC)
      aliases:
      - Ext_Courtesy_Sw_Input_Cfg
      target_state: ECSIC MAN_PUDDLE
      state_aliases:
      - MAN_Puddle
    - bit: 0
      action: 0
      feature_name: Ext_Courtesy_Sw_Input_Cfg (ECSIC)
      aliases:
      - Ext_Courtesy_Sw_Input_Cfg
      target_state: ECSIC NULL
      state_aliases:
      - 'Null'
  - mask: xxx* xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: Rear_Ext_Courtesy_Mode_Cfg (RECMC)
      aliases:
      - Rear_Ext_Courtesy_Mode_Cfg
      target_state: RECMC NULL
      state_aliases:
      - 'Null'
    - bit: 0
      action: 1
      feature_name: Rear_Ext_Courtesy_Mode_Cfg (RECMC)
      aliases:
      - Rear_Ext_Courtesy_Mode_Cfg
      target_state: RECMC BEDLIGHT
      state_aliases:
      - Bed Light
      - RECMC FLOODLIGHT
recipe_version: '1.1'
