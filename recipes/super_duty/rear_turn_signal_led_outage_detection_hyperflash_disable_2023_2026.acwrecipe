title: Rear Turn Signal LED Outage Detection (Hyperflash Disable)
raw_community_title: Bulb-Rear Turn LED Outage Detection
category: Lighting
platform: Super Duty
model_years: 2023-2026
trim: All
source_sheet: 2023-2026 Super Duty Common Items.xlsx
notes: 0=No Outage 1=Outage
steps:
- module: BdyCm-BCM
  address: 726-40-02
  notes: 0=No Outage 1=Outage
  targets:
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: Rear_LED_Turn_Outage_Cfg (RLEDTOC)
      aliases:
      - Rear_LED_Turn_Outage_Cfg
      target_state: RLEDTOC NO_OUTAGE
      state_aliases:
      - No Outage
recipe_version: '1.1'
