title: Keyfob Panic Alarm Enable/Disable
raw_community_title: Keyfob Panic Alarm (2021-2026)
category: Locks and Security
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: 0=lights & horn (default) 1=lights only (target setting)
steps:
- module: BCM
  address: 726-01-02
  notes: 0=lights & horn (default) 1=lights only
  targets:
  - mask: xxxx xxx* xx--
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: PanicAlarm_Cfg (PAC)
      aliases:
      - PanicAlarm_Cfg
      target_state: PAC LIGHTS_ONLY
      state_aliases:
      - Lights_Only
recipe_version: '1.1'
