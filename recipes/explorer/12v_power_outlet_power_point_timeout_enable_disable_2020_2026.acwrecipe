title: 12V Power Outlet (Power Point) Timeout Enable/Disable
raw_community_title: Powerpoint Timeout disable
category: Convenience and Electrical
platform: Explorer
model_years: 2020-2026
trim: All
source_sheet: 2020-2024 Explorer.xlsx
notes: this will disable the timeout, be aware it will be constant powered and can
  deplete battery.
steps:
- module: BCM
  address: 726-57-01
  targets:
  - mask: xxxx x*xx xx--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 0
      feature: Power_Point_Timeout_Cfg (PPTC)
recipe_version: '1.1'
