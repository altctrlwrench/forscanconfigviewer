title: BlueCruise 1.4 Settings (Lane Biasing & Curve Speed)
raw_community_title: Bluecruise 1.4 Settings   (IPMA strategy must be on ACJ or BBC
  for this to work)
category: General
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: Lane Biasing (Under Cruise Control), Predictive Speed Assist (Under Cruise
  Control)
steps:
- module: APIM
  address: 7D0-09-05
  notes: Lane Biasing (Under Cruise Control), Predictive Speed Assist (Under Cruise
    Control)
  targets:
  - mask: xxxx xx*x xx--
    community_hex: '4'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature_name: Lane Biasing (LB)
      target_state: LB Enabled
  - mask: xxxx xxxx *x--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature_name: Curve Speed Control Menu (CSCM)
      target_state: CSCM Enabled
    - bit: 1
      action: 1
      feature_name: Predictive Speed Assist (PSA)
      target_state: PSA Enabled
- module: APIM
  address: 7D0-10-02
  notes: Lane Change Assist (under Cruise Control)
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Assisted Lane Change  (ALC)
      target_state: ALC Enabled
- module: IPMA
  address: 706-01-01
  notes: MFCLKS LKAlert+LKAid+LCWA
  targets:
  - mask: x*xx xxxx xx--
    community_hex: E
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: ModuleFeatureCfg_LKS (MFCLKS)
      target_state: MFCLKS LKAlert+LKAid
    - bit: 2
      action: 1
      feature_name: ModuleFeatureCfg_LKS (MFCLKS)
      target_state: MFCLKS LKAlert
    - bit: 1
      action: 1
      feature_name: ModuleFeatureCfg_DAS (MFCDAS)
      target_state: MFCDAS Enabled
    - bit: 0
      action: 0
      feature_name: Unused_1 (U)
      target_state: U Unused
- module: IPMA
  address: 706-01-02
  notes: ModuleFeatureCfg_ALB (MFCALB)&ModuleFeatureCfg_ALC (MFCALC)
  targets:
  - mask: x*xx xxxx xx--
    community_hex: '5'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature_name: ModuleFeatureCfg_ALB (MFCALB)
      target_state: MFCALB Enabled
    - bit: 0
      action: 1
      feature_name: ModuleFeatureCfg_ALC (MFCALC)
      target_state: MFCALC Enabled
- module: IPMA
  address: 706-02-02
  notes: FeatureCfg_IACCMode (FCIACCM) FCIACCM Preview+CurveControl
  targets:
  - mask: xxxx xxxx x*--
    community_hex: '2'
    offset_hint: +C
    type: discrete
- module: IPMA
  address: 706-38-01
  notes: CustomerSetting_ALBSelected_Vehicle (CSALBSV),  CustomerSetting_ALCSelected_Vehicle
    (CSALCSV)
  targets:
  - mask: x*xx xxxx xx--
    community_hex: '8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: CustomerSetting_ALBSelected_Vehicle (CSALBSV)
      target_state: CSALBSV On
  - mask: xxx* xxxx xx--
    community_hex: '8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: CustomerSetting_ALCSelected_Vehicle (CSALCSV)
      target_state: CSALCSV On
recipe_version: '1.1'
