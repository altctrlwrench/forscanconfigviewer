title: Auto Relock on Unopened Door Enable
raw_community_title: Auto Relock
category: Locks and Security
platform: F-150 Lightning
model_years: 2022-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro & Lightning Community
source_sheet: F-150 Lightning FORScan Thread
notes: If you unlock on the fob and do not open a door within the timer, the truck
  re-locks automatically. Adds Relock toggle to Lock Settings.
steps:
- module: BCM
  address: 726-20-01
  mask: x*x* x*x* x*--
  nibbles:
  - nibble: 1
    recommended_hex: '1'
    community_instruction: Change from 0 to 1
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_1] (AUTORELOCK_PERS_1)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_1] (AUTORELOCK_PERS_1)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_1] (AUTORELOCK_PERS_1)
      target_state: Disabled
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_1] (AUTORELOCK_PERS_1)
      target_state: Enabled
  - nibble: 3
    recommended_hex: '1'
    community_instruction: Change from 0 to 1
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_2] (AUTORELOCK_PERS_2)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_2] (AUTORELOCK_PERS_2)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_2] (AUTORELOCK_PERS_2)
      target_state: Disabled
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_2] (AUTORELOCK_PERS_2)
      target_state: Enabled
  - nibble: 5
    recommended_hex: '1'
    community_instruction: Change from 0 to 1
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_3] (AUTORELOCK_PERS_3)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_3] (AUTORELOCK_PERS_3)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_3] (AUTORELOCK_PERS_3)
      target_state: Disabled
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_3] (AUTORELOCK_PERS_3)
      target_state: Enabled
  - nibble: 7
    recommended_hex: '1'
    community_instruction: Change from 0 to 1
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_4] (AUTORELOCK_PERS_4)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_4] (AUTORELOCK_PERS_4)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_4] (AUTORELOCK_PERS_4)
      target_state: Disabled
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [AUTORELOCK] [PERS_4] (AUTORELOCK_PERS_4)
      target_state: Enabled
  - nibble: 9
    recommended_hex: '1'
    community_instruction: Change from 0 to 1
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [VEHICLE] (AUTORELOCK_VEHICLE)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [VEHICLE] (AUTORELOCK_VEHICLE)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [AUTORELOCK] [VEHICLE] (AUTORELOCK_VEHICLE)
      target_state: Disabled
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [AUTORELOCK] [VEHICLE] (AUTORELOCK_VEHICLE)
      target_state: Enabled
- module: BCM
  address: 726-27-01
  mask: xxxx xxxx x*--
  nibbles:
  - nibble: 9
    recommended_hex: '1'
    community_instruction: change 0 to 1
    bits:
    - bit: 3
      action: 0
      feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
      target_state: Disabled
    - bit: 0
      action: 1
      feature_name: FeatLst_to_BCM_Feature_InitVal [AUTORELOCK] (AUTORELOCK)
      target_state: Enabled
- module: BCM
  address: 726-58-02
  mask: x*xx xxxx xx--
  nibbles:
  - nibble: 1
    recommended_hex: '1'
    target_state: 30 Seconds
    feature_name: AutoRelock_Timeduration_Cfg (ARTC)
    bits:
    - bit: 3
      action: 0
      feature_name: AutoRelock_Timeduration_Cfg (ARTC)
      target_state: 30 Seconds
    - bit: 2
      action: 0
      feature_name: AutoRelock_Timeduration_Cfg (ARTC)
      target_state: 30 Seconds
    - bit: 1
      action: 0
      feature_name: AutoRelock_Timeduration_Cfg (ARTC)
      target_state: 30 Seconds
    - bit: 0
      action: 1
      feature_name: AutoRelock_Timeduration_Cfg (ARTC)
      target_state: 30 Seconds
  notes: 'Auto relock duration: 1 = 30 seconds (recommended default), 2 = 45 seconds.'
- module: APIM
  address: 7D0-09-01
  mask: xx*x xxxx xx--
  nibbles:
  - nibble: 2
    recommended_hex: '3'
    community_instruction: change 1 to 3
    bits:
    - bit: 3
      action: 0
      feature_name: Autolock Control Function (ACF)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Adaptive Head Lamps Traffic (AHLT)
      target_state: Disabled
    - bit: 1
      action: 1
      feature_name: Auto Relock (AR)
      target_state: Enabled
    - bit: 0
      action: 1
      feature_name: Autounlock Control Function (ACF)
      target_state: Enabled
validation_status: validated
