title: Rear Turn Signal Bulb Outage Detection
raw_community_title: Rear Turn Bulb Outage Detection (2021-2023)
category: Lighting
platform: F-150
model_years: 2021-2023
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
notes: 00=No Outage (Target setting) 01=Outage. Set to No Outage if changing to LED
steps:
- module: BCM
  address: 726-44-02
  mask: '**xx xxxx xx--'
  notes: 00=No Outage 01=Outage - set to no outage when upgrading to LED
  nibbles:
  - nibble: 0
    notes: 00=No Outage 01=Outage - set to no outage when upgrading to LED | Left
      factory (no data table)
    community_instruction: 00=No Outage 01=Outage - set to no outage when upgrading
      to LED | Left factory (no data table)
    bits:
    - bit: 3
      action: 0
      feature_name: VrmsReduce_Low_Beam_Cfg (VRLBC)
    - bit: 2
      action: 0
      feature_name: VrmsReduce_Low_Beam_Cfg (VRLBC)
    - bit: 1
      action: 0
      feature_name: VrmsReduce_Low_Beam_Cfg (VRLBC)
    - bit: 0
      action: 0
      feature_name: VrmsReduce_Low_Beam_Cfg (VRLBC)
  - nibble: 1
    notes: No info for 24+ | Left factory (no data table)
    bits:
    - bit: 3
      action: 0
      feature_name: VrmsReduce_Low_Beam_Cfg (VRLBC)
    - bit: 2
      action: 0
      feature_name: VrmsReduce_Low_Beam_Cfg (VRLBC)
    - bit: 1
      action: 0
      feature_name: VrmsReduce_Low_Beam_Cfg (VRLBC)
    - bit: 0
