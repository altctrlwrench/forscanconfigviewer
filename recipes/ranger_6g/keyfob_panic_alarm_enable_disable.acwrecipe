title: Keyfob Panic Alarm Enable/Disable
raw_community_title: Keyfob Panic Alarm
category: Locks and Security
platform: Ranger (6G)
model_years: 2024+
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'FORScan Menu: Panic Alarm Mode (Change Honk and Lights to Lights only)

  Trim: All? [Confirmed: craigc (9/10/2024) Lariat FX4]'
forscan_menu: Panic Alarm Mode (Change Honk and Lights to Lights only)
steps:
- module: BCM
  address: 726-01-02
  mask: xxxx xxx* xx--
  notes: 0=lights & horn (default) 1=lights only (target setting)
  community_instruction: 0=lights & horn (default) 1=lights only (target setting)
  nibbles:
  - nibble: 7
    bits:
    - bit: 3
      action: 0
      feature_name: PanicAlarm_Cfg (PAC)
      target_state: PAC BOTH
    - bit: 2
      action: 0
      feature_name: PanicAlarm_Cfg (PAC)
      target_state: PAC BOTH
    - bit: 1
      action: 0
      feature_name: PanicAlarm_Cfg (PAC)
      target_state: PAC BOTH
    - bit: 0
      action: 1
      feature_name: PanicAlarm_Cfg (PAC)
      target_state: PAC LIGHTS_ONLY
    notes: 0=lights & horn (default) 1=lights only (target setting)
