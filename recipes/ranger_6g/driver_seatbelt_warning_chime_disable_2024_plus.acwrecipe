title: Driver Seatbelt Warning Chime Disable
raw_community_title: Disables chime for Driver seatbelt
category: Chimes and Horn
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'FORScan Menu: Belt Minder Chime - Row 1 Col 1 (Set to Disabled. Also can be
  done using procedure in user manual)

  Trim: All [Confirmed: craigc (7/31/24) Lariat FX4]'
steps:
- module: IPC
  address: 720-13-01
  notes: '* Bit 1 (subtract 1 to disable, e.g. change F to E)

    FORScan Menu: Belt Minder Chime - Row 1 Col 1 (Set to Disabled. Also can be done
    using procedure in user manual)

    Trim: All [Confirmed: craigc (7/31/24) Lariat FX4]'
  targets:
  - mask: '*xxx xxxx xx--'
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: R1C1 Belt Minder Chime (RCBMC)
      aliases:
      - R1C1_Belt_Minder_Chime_Cfg (RCBMCC)
      target_state: RCBMC Disabled
recipe_version: '1.1'
