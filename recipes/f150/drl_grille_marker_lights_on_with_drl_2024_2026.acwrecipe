title: DRL - Grille Marker Lights On with DRL
raw_community_title: (2024-2026) Raptor (marker lights on with DRL)
category: Lighting
platform: F-150
model_years: 2024-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: Daytime Running Lights (DRL) Include Parklamps Config
steps:
- module: BCM
  address: 726-38-01
  notes: Daytime Running Lights (DRL) Include Parklamps Config
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: DRL - Grille Marker Lights On with DRL
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: DRL - Grille Marker Lights On with DRL
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: DRL - Grille Marker Lights On with DRL
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: DRL - Grille Marker Lights On with DRL
      target_state: Disabled
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: DRL_IncludeParklamps_Cfg (DRLIPC)
      aliases:
      - DRL_IncludeParklamps_Cfg
      target_state: DRLIPC ENABLE
      state_aliases:
      - Enable
- module: BCM
  address: 726-43-02
  notes: Daytime Running Lights (DRL) On With Park Lamps On Config
  targets:
  - mask: xxxx xx*x xx--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: DRL_OnWithParkLampsOn_Cfg (DRLOWPLOC)
      aliases:
      - OutageABM_Cfg (OABMC)
      - OutageABM_Cfg
      target_state: DRLOWPLOC ENABLE
- module: BCM
  address: 726-87-01
  notes: Daytime Running Lights (DRL) Suppress License Config
  targets:
  - mask: xx*x xxxx xx--
    community_hex: '0'
    type: discrete
  - mask: xxx* xxxx xx--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: DRL_SuppressLicense_Cfg (DRLSLC)
      aliases:
      - SlaveExists_OHC_Cfg (SEOHCC)
      - SlaveExists_OHC_Cfg
      target_state: DRLSLC NOT_SUPPRESSED
recipe_version: '1.1'
