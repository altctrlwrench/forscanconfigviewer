title: DRL - Full Brightness with Headlamps On
raw_community_title: DRLs - full brightness
category: Lighting
platform: Explorer
model_years: 2025-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2025-2026 Explorer.xlsx
steps:
- module: BCM
  address: 726-42-01
  mask: x*x* xxxx xx--
  nibbles:
  - nibble: 1
    recommended_hex: '2'
    feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
    target_state: LFDRLLCUC NOT_USED
    bit: 3
    action: 0
  - nibble: 3
    recommended_hex: '2'
    feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
    target_state: RFDRLLCUC NOT_USED
    bit: 3
    action: 0
- module: BCM
  address: 726-38-01
  mask: xxxx **xx xx--
  type: continuous
  instruction: 'set at about 60% brightness (3C hex) thru 75% brightness (4B hex)
    use lowest value you can before flickering appears.


    64 =100%, 5A = 90%, 4B =75%, 32 = 50%, 19 = 25%, 0A =10%'
