title: Double Horn Honk on Keyless Exit Disable
raw_community_title: Disable Double Honk
category: Chimes and Horn
platform: Explorer
model_years: 2025-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2025-2026 Explorer.xlsx
notes: disables double honk when exiting the vehicle.
steps:
- module: BCM
  address: 726-63-02
  mask: xxx* xxxx xxxx
  nibbles:
  - nibble: 3
    bits:
    - bit: 3
      action: 0
      feature_name: LostPKExteriorNotificationEnable_Cfg (LPKENEC)
      target_state: LPKENEC DISABLED
    - bit: 2
      action: 0
      feature_name: LostPKExteriorNotificationEnable_Cfg (LPKENEC)
      target_state: LPKENEC DISABLED
    - bit: 1
      action: 0
      feature_name: LostPKExteriorNotificationEnable_Cfg (LPKENEC)
      target_state: LPKENEC DISABLED
    - bit: 0
      action: 0
      feature_name: LostPKExteriorNotificationEnable_Cfg (LPKENEC)
      target_state: LPKENEC DISABLED
    recommended_hex: '0'
