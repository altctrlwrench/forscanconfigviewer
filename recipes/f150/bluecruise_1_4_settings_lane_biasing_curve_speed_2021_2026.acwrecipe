title: BlueCruise 1.4 Settings (Lane Biasing & Curve Speed)
raw_community_title: Bluecruise 1.4 Settings   (IPMA strategy must be on ACJ or BBC
  for this to work)
category: General
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: Lane Biasing (Under Cruise Control), Predictive Speed Assist (Under Cruise
  Control)
steps:
- module: APIM
  address: 7D0-09-05
  notes: Lane Biasing (Under Cruise Control), Predictive Speed Assist (Under Cruise
    Control)
  targets:
  - mask: xxxx xx*x xx--
    community_hex: '4'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature: Lane Biasing (LB)
  - mask: xxxx xxxx *x--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature: Curve Speed Control Menu (CSCM)
    - bit: 1
      action: 1
      feature: Predictive Speed Assist (PSA)
- module: APIM
  address: 7D0-10-02
  notes: Lane Change Assist (under Cruise Control)
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature: Assisted Lane Change  (ALC)
- module: IPMA
  address: 706-01-01
  notes: MFCLKS LKAlert+LKAid+LCWA
  targets:
  - mask: x*xx xxxx xx--
    community_hex: E
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature: ModuleFeatureCfg_LKS (MFCLKS)
    - bit: 2
      action: 1
      feature: ModuleFeatureCfg_LKS (MFCLKS)
    - bit: 1
      action: 1
      feature: ModuleFeatureCfg_DAS (MFCDAS)
    - bit: 0
      action: 0
      feature: Unused_1 (U)
- module: IPMA
  address: 706-01-02
  notes: ModuleFeatureCfg_ALB (MFCALB)&ModuleFeatureCfg_ALC (MFCALC)
  targets:
  - mask: x*xx xxxx xx--
    community_hex: '5'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature: ModuleFeatureCfg_ALB (MFCALB)
    - bit: 0
      action: 1
      feature: ModuleFeatureCfg_ALC (MFCALC)
- module: IPMA
  address: 706-02-02
  notes: FeatureCfg_IACCMode (FCIACCM) FCIACCM Preview+CurveControl
  targets:
  - mask: xxxx xxxx x*--
    community_hex: '2'
    offset_hint: +C
    type: discrete
- module: IPMA
  address: 706-38-01
  notes: CustomerSetting_ALBSelected_Vehicle (CSALBSV),  CustomerSetting_ALCSelected_Vehicle
    (CSALCSV)
  targets:
  - mask: x*xx xxxx xx--
    community_hex: '8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature: CustomerSetting_ALBSelected_Vehicle (CSALBSV)
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 0
  - mask: xxx* xxxx xx--
    community_hex: '8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature: CustomerSetting_ALCSelected_Vehicle (CSALCSV)
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 0
recipe_version: '1.1'
