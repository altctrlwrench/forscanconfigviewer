title: Silent Mode / Police Dark Car Mode
raw_community_title: 2021-26 Silent Mode - adds toggle in Sync under Settings, Vehicle
  (prevents any approach lighting, lock/unlock lighting, courtesy lights until truck
  is turned on)
category: Lighting
platform: F-150
model_years: 2021-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
notes: 'add 1 to current value (if C, make D) Note: reset APIM after change if toggle
  doesn''t show (forscan wrench icon)'
post_procedure: Reset APIM in FORScan or cycle ignition.
steps:
- module: APIM
  address: 7D0-09-02
  mask: '*xxx xxxx xx--'
  notes: 'add 1 to current value (if C, make D) Note: reset APIM after change if toggle
    doesn''t show (forscan wrench icon)'
  community_instruction: 'add 1 to current value (if C, make D) Note: reset APIM after
    change if toggle doesn''t show (forscan wrench icon)'
  nibbles:
  - nibble: 0
    bits:
    - bit: 0
      action: 1
      feature_name: Silent Mode Control Function (SMCF)
      target_state: SMCF Enabled
    hex_offset: '+1'
    notes: 'add 1 to current value (if C, make D) Note: reset APIM after change if
      toggle doesn''t show (forscan wrench icon)'
validation_status: validated
