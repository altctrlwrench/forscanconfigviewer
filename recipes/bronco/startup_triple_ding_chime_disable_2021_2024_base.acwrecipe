title: Startup Triple Ding Chime Disable
raw_community_title: Disables Triple Ding at Start up (Doo, doo, doo)
category: Chimes and Horn
platform: Bronco
model_years: 2021-2024
trim: Base (Standard Cluster)
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2022 Bronco.xlsx
notes: 'Confirmed: mrjking200'
steps:
- module: IPC
  address: 720-01-02
  mask: xxxx x*-- xx--
  notes: Seatbelt warning market to ECE
  nibbles:
  - nibble: 5
    bits:
    - bit: 3
      action: 0
      feature_name: Fuel Operated Heater  (FOH)
    - bit: 1
      action: 1
      feature_name: Seatbelt Warning Market (SWM)
      target_state: SWM ECE
    recommended_hex: '2'
    notes: Seatbelt warning market to ECE
