title: Diesel Exhaust Auto Regen Control Checkbox Enable
raw_community_title: Auto Regen Checkbox
category: Powertrain and Drivetrain
platform: Super Duty
model_years: 2023-2026
trim: Diesel (6.7L Powerstroke)
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2023 Super Duty.xlsx
notes: '[PCM] Plain English - Select option 3 under manual regen

  Add 8 to current value

  Add 2 to current value'
steps:
- module: IPC
  address: 720-07-02
  mask: xxx* xx
  notes: '[PCM] Plain English - Select option 3 under manual regen

    Add 8 to current value'
  nibbles:
  - nibble: 3
    bits:
    - bit: 3
      action: 1
      feature_name: Auto Regen Control (ARC)
      target_state: ARC enabled
    hex_offset: '+8'
    notes: '[PCM] Plain English - Select option 3 under manual regen

      Add 8 to current value'
- module: APIM
  address: 7D0-09-03
  mask: xxxx x*xx xx--
  notes: Add 2 to current value
  nibbles:
  - nibble: 5
    bits:
    - bit: 1
      action: 1
      feature_name: Auto Regen Control (ARC)
      target_state: ARC Enabled
    hex_offset: '+8'
    notes: Add 2 to current value
