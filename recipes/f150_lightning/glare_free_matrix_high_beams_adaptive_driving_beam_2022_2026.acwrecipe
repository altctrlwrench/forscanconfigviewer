title: Glare-Free Matrix High Beams (Adaptive Driving Beam)
raw_community_title: ⚡ [Lightning] Glare-Free High Beams (Matrix LED Enable)
category: Lighting
platform: F-150 Lightning
model_years: 2022-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Lighting] [Years: 2022-2026] [Original Title: Glare-free headlights]

  Enhances Auto High Beam behavior to provide localized dimming of brights based on
  surrounding traffic. Dynamic bending lights continue to work. May take a couple
  of restarts to take effect. Specific to Lightnings. Ensure no checksum DTCs are
  set for the HCM.'
steps:
- module: APIM
  address: 7D0-09-01
  targets:
  - mask: x*xx xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Autolamp Delay (AD)
      target_state: AD Enabled
- module: APIM
  address: 7D0-09-03
  targets:
  - mask: xx*x xxxx xx--
    community_hex: C
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: Air Suspension SUMA Control Function (ASSUMACF)
      target_state: ASSUMACF Disabled
    - bit: 0
      action: 0
      feature_name: Air Suspension Auto Height SUMA (ASAHSUMA)
      target_state: ASAHSUMA Disabled
- module: IPMA
  address: 706-01-01
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '9'
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: ModuleFeatureCfg_RBA (MFCRBA)
      target_state: MFCRBA Disabled
    - bit: 0
      action: 1
      feature_name: ModuleFeatureCfg_RBA (MFCRBA)
      target_state: MFCRBA RBA
- module: SCCM
  address: 724-04-01
  targets:
  - mask: xxx* xxxx xx--
    community_hex: '4'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF ADB
    - bit: 1
      action: 0
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF Undefined
    - bit: 0
      action: 0
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF Undefined
- module: IPC
  address: 720-01-01
  targets:
  - mask: xx*x xxxx xx--
    community_hex: '8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Adaptive Head Lamps Control Function (AHLCF)
      target_state: AHLCF enabled
- module: IPC
  address: 720-10-01
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '3'
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: AutoHighBeam Menu (AHBM)
      target_state: AHBM Glarefree High Beams
    - bit: 0
      action: 1
      feature_name: AutoHighBeam Menu (AHBM)
      target_state: AHBM Auto HighBeams
- module: HCM
  address: 734-01-02
  targets:
  - mask: xxxx x*xx xx--
    community_hex: '2'
    type: discrete
- module: HCM
  address: 734-03-02
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: m2_ADB_DBL_combine (ADBDBL)
      target_state: ADBDBL ADB/DBL Combined
- module: HCM
  address: 734-11-01
  targets:
  - mask: '*xxx xxxx xx--'
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
  - mask: x*xx xxxx xx--
    community_hex: '7'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 2
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
    - bit: 1
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
    - bit: 0
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
  - mask: xx*x xxxx xx--
    community_hex: '3'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 1
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
    - bit: 0
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
  - mask: xxx* xxxx xx--
    community_hex: '5'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 2
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
    - bit: 1
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 0
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
  - mask: xxxx *xxx xx--
    community_hex: '8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
      target_state: Enabled
    - bit: 2
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
      target_state: Disabled
  - mask: xxxx x*xx xx--
    community_hex: '9'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
      target_state: Enabled
    - bit: 2
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
      target_state: Disabled
