title: Sync Climate Bar - Heated & Cooled Seat Icons
raw_community_title: Enable Cooled and/or Heated Seats to Climate Bar
category: Sync and Infotainment
platform: Super Duty
model_years: 2023-2026
trim: All
source_sheet: 2023-2026 Super Duty Common Items.xlsx
notes: if you have heated & cooled seats then use A
steps:
- module: APIM
  address: 7D0-02-01
  notes: if you have heated & cooled seats then use A
  targets:
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Heated Seats HMI (HSHMI)
      target_state: HSHMI Heated and Cooled
    - bit: 2
      action: 0
      feature_name: Heated Seats HMI (HSHMI)
      target_state: HSHMI Heated and Cooled
recipe_version: '1.1'
