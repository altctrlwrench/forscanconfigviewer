title: Keyfob Panic Alarm Enable/Disable
raw_community_title: Keyfob Panic Alarm
category: Locks and Security
platform: Explorer
model_years: 2020-2026
trim: All
source_sheet: 2020-2024 Explorer.xlsx
notes: 0=Disabled, 1=Enabled (2 press), 2=Enabled (1 press)
steps:
- module: BCM
  address: 726-62-01
  targets:
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: PanicActivate_Cfg (PAC)
      target_state: PAC DOUBLE
    - bit: 0
      action: 1
      feature_name: PanicActivate_Cfg (PAC)
      target_state: PAC DOUBLE
- module: BCM
  address: 726-01-02
  notes: 0=Lights and Horn, 1=Horn only
  targets:
  - mask: xxxx xxx* xx--
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: PanicAlarm_Cfg (PAC)
      target_state: PAC BOTH
recipe_version: '1.1'
