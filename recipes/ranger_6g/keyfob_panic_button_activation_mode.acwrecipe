  community_instruction: 0=disabled, 1=2 clicks (target setting), 2=one click (default)
  bits:
  - bit: 3
    action: 0
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DISABLE
  - bit: 2
    action: 0
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DISABLE
  - bit: 1
    action: 0
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DISABLE
  - bit: 0
    action: 1
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DOUBLE
