title: Front Turn Signal Bulb Outage Detection
raw_community_title: Front Turn Bulb Outage Detection (2021-2026)
category: Lighting
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: 00=No Outage (target setting) 01=Outage. Set to No Outage if upgrading to LED
steps:
- module: BCM
  address: 726-40-02
  notes: 00=No Outage 01=Outage - set to no outage when upgrading to LED
  targets:
  - mask: '*xxx xxxx xx--'
    type: discrete
    community_hex: '0'
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: Front_Bulb_Turn_Outage_Cfg (FBTOC)
      aliases:
      - Front_Bulb_Turn_Outage_Cfg
      target_state: FBTOC NO_OUTAGE
      state_aliases:
      - No Outage
recipe_version: '1.1'
