title: Sync Splash Screen - F-150 Lightning Animation
raw_community_title: Enable Lightning F150 Splash Screen
category: Sync and Infotainment
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
steps:
- module: APIM
  address: 7D0-03-01
  targets:
  - mask: xxxx *xxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 2
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 1
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 0
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Stock Ford/Lincoln Splash Screen, as determined by brand bit
  - mask: xxxx x*xx xx--
    community_hex: F
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Mustang Shelby R1
      state_aliases:
      - SS Continental
    - bit: 2
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Black Label
      state_aliases:
      - SS Continental
    - bit: 1
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS F150
      state_aliases:
      - SS Continental
    - bit: 0
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Stock Ford/Lincoln Splash Screen, as determined by brand bit
recipe_version: '1.1'
