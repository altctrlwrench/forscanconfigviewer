title: Autolock / Autounlock Sync Menu Toggle Enable
raw_community_title: Auto lock menu control
category: Locks and Security
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: "Enables the Auto Unlock and Auto-relock control options \nPossible to use\
  \ FORScan easy mode\nFORScan Menu: Auto Lock Control Function (Disabled (Default),\
  \ Enabled)\nTrim: Enable/Disable [Confirmed: craigc (9/12/2024) Lariat]"
steps:
- module: APIM
  address: 7D0-09-01
  notes: 'Suggest to use the non-asbuilt menu to change

    * -> Bit 4 (Add 8 to enable, e.g. change 3 to B)

    FORScan Menu: Auto Lock Control Function (Disabled (Default), Enabled)

    Trim: Enable/Disable [Confirmed: craigc (9/12/2024) Lariat]'
  targets:
  - mask: xx*x xxxx xx--
    offset_hint: '+8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature: Autolock Control Function (ACF)
    - bit: 0
      action: 1
      feature: Autounlock Control Function (ACF)
recipe_version: '1.1'
