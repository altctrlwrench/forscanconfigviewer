title: Front Turn Signal Bulb Outage Detection
raw_community_title: Bulb-Front Turn Bulb Outage Detection
category: Lighting
platform: Super Duty
model_years: 2023-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2023 Super Duty.xlsx
notes: 0=No Outage 1=Outage - set to 0 for LED
steps:
- module: BDYCM-BCM
  address: 726-40-02
  mask: x*xx xxxx xx--
  notes: 'Disable Front Turn Bulb Outage Detection

    0=No Outage 1=Outage - set to 0 to disable'
  community_instruction: 'Disable Front Turn Bulb Outage Detection

    0=No Outage 1=Outage - set to 0 to disable'
  nibbles:
  - nibble: 1
    bits:
    - bit: 3
      action: 0
      feature_name: Front_Bulb_Turn_Outage_Cfg (FBTOC)
      target_state: FBTOC NO_OUTAGE
    - bit: 2
      action: 0
      feature_name: Front_Bulb_Turn_Outage_Cfg (FBTOC)
      target_state: FBTOC NO_OUTAGE
    - bit: 1
      action: 0
      feature_name: Front_Bulb_Turn_Outage_Cfg (FBTOC)
      target_state: FBTOC NO_OUTAGE
    - bit: 0
      action: 0
      feature_name: Front_Bulb_Turn_Outage_Cfg (FBTOC)
      target_state: FBTOC NO_OUTAGE
    notes: 'Disable Front Turn Bulb Outage Detection

      0=No Outage 1=Outage - set to 0 to disable'
