    in BdyCM (easy way): '
  feature_name: Global_Close_Cfg (GCC)
  target_state: GCC DISABLED
  bit: 3
  action: 0
- module: DDM
  address: 740-06-02
  mask: xxxx xxx* xx--
  nibble: 7
  recommended_hex: '1'
  feature_name: Global_Close_Cfg (GCC)
  target_state: GCC DISABLED
