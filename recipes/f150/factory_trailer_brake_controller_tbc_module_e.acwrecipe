title: Factory Trailer Brake Controller (TBC) Module Enable
raw_community_title: 2021-26 - Adding OEM Trailer Brake Controller
category: Powertrain and Drivetrain
platform: F-150
model_years: 2021-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
steps:
- module: IPC
  address: 720-07-01
  mask: xxxx x*xx xx--
  nibble: 5
  community_instruction: use E for a turbo engine, use A for a 5.0L
  feature_name: Trailer Brake Controller (TBC)
  target_state: TBC enabled
  bit: 3
  action: 1
- module: BCM
  address: 726-69-02
  mask: xxxx x*xx x*--
  nibbles:
  - nibble: 5
    recommended_hex: '1'
    feature_name: TBM_Available_Cfg (TBMAC)
    target_state: TBMAC ABSENT
    bit: 3
    action: 0
  - nibble: 9
    recommended_hex: '1'
    feature_name: TRM_Available_Cfg (TRMAC)
    target_state: TRMAC ABSENT
    bit: 3
    action: 0
- module: TRM
  address: 791-01-02
  mask: xxxx x*--
  nibble: 5
  hex_offset: '+1'
  community_instruction: add 1 to current value (if 4 make 5, if 2 make 3)
  feature_name: TBM_Cfg (TBMC)
  target_state: TBMC PRESENT
  bit: 0
  action: 1
- module: APIM
  address: 7D0-09-03
  mask: xxxx xxx* xx--
  nibble: 7
  recommended_hex: '4'
  feature_name: Trailer Brake Controller (TBC)
  target_state: TBC Enabled
  bit: 2
  action: 1
- module: IPMA
  address: 706-18-01
  mask: xxxx xxx* xx--
  nibble: 7
  recommended_hex: C
  feature_name: VehicleInfo_TrailerLightModule (VITLM)
  target_state: VITLM Present
  bit: 3
  action: 1
