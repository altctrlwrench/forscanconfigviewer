title: Drive Mode - Rock Crawl Enable
raw_community_title: Enable ROCK/CRAWL mode on XL, XLT, lariat, etc.
category: Powertrain and Drivetrain
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'FORScan Menu: SDM - Mode 10 (Rock/Crawl?) (Disabled (Default), Enabled)

  Trim: 4x4 [Confirmed: craigc (9/12/2024) Lariat]'
steps:
- module: ABS
  address: 760-04-03
  notes: '* -> 3=Enabled

    FORScan Menu: SDM - Mode 10 (Rock/Crawl?) (Disabled (Default), Enabled)

    Trim: 4x4 [Confirmed: craigc (9/12/2024) Lariat]'
  targets:
  - mask: xxxx xxx* xx--
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: SDM_GENERIC_MODE10 (SDMGENERICMODE)
      aliases:
      - SDM_GENERIC_MODE1
      target_state: SDMGENERICMODE Enabled
      state_aliases:
      - Mode1 disabled
recipe_version: '1.1'
