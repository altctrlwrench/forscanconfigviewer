title: Auto Start/Stop System Disable
raw_community_title: Disable Auto Start-Stop
category: Powertrain and Drivetrain
platform: Bronco
model_years: 2021-2024
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2022 Bronco.xlsx
steps:
- module: PSCM
  address: 730-03-01
  mask: xxxx xxxx **--
  nibbles:
  - nibble: 8
    community_instruction: 'Start / Stop: 00=Disabled 01=Enabled, Angle Inhibit Enabled
      02=Enabled, Angle Inhibit Disabled'
    feature_name: EOL Configuration Byte (EOLCB)
    target_state: EOLCB Not Configured
    bit: 3
    action: 0
  - nibble: 9
    community_instruction: 'Start / Stop: 00=Disabled 01=Enabled, Angle Inhibit Enabled
      02=Enabled, Angle Inhibit Disabled'
    feature_name: Start / Stop (SS)
    target_state: SS Start/Stop Disabled
    bit: 3
    action: 0
