title: Digital Gauge Numeric Temperatures Display (Engine & Trans)
raw_community_title: Enable digital temps for engine & transmission on 12" digital
  cluster only
category: Cluster and Displays
platform: F-150
model_years: 2021-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
notes: E5 (turbo & trailer brake controller), 65 (turbo & no TBC), A5 (non-turbo &
  TBC), 25 (non-turbo & no TBC)
steps:
- module: IPC
  address: 720-07-01
  mask: xxxx x**x xx--
  notes: E5 (turbo & trailer brake controller), 65 (turbo & no TBC), A5 (non-turbo
    & TBC), 25 (non-turbo & no TBC)
  nibbles:
  - nibble: 5
    notes: E5 (turbo & trailer brake controller), 65 (turbo & no TBC), A5 (non-turbo
      & TBC), 25 (non-turbo & no TBC) | Enables only Turbo Boost and Digital Gauge
      Interface
    bits:
    - bit: 2
      action: 1
      feature_name: Turbo Boost (TB)
      target_state: TB Yes
    - bit: 1
      action: 1
      feature_name: Digital Gauge Interface (DGI)
      target_state: DGI enabled
  - nibble: 6
    hex_offset: '-1'
    notes: E5 (turbo & trailer brake controller), 65 (turbo & no TBC), A5 (non-turbo
      & TBC), 25 (non-turbo & no TBC) | Engine Temp and Trans Temp always on (subtract
      1 to disable trans temp)
    bits:
    - bit: 3
      action: 0
      feature_name: Eng Temp Dig (ETD)
      target_state: ETD Always Off
    - bit: 2
      action: 1
      feature_name: Eng Temp Dig (ETD)
      target_state: ETD Always On
    - bit: 1
      action: 0
      feature_name: Trans Temp Dig (TTD)
      target_state: TTD Always Off
    - bit: 0
      action: 1
      feature_name: Trans Temp Dig (TTD)
      target_state: TTD Always On
