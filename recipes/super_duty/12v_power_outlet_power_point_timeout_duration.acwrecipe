title: 12V Power Outlet (Power Point) Timeout Duration
raw_community_title: PowerPoint Max Timeout
category: Convenience and Electrical
platform: Super Duty
model_years: 2023-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2023 Super Duty.xlsx
notes: 'Seconds converted to Hex (Stock is 1194-75 minutes)

  0001 for 1 second, 001E for 30 seconds, 003C for 1 minute, 012C for 5 minutes, 0258
  for 10 minutes, 0708 for 30 minutes, and 0E10 for 1 hour'
steps:
- module: BDYCM-BCM
  address: 726-57-01
  mask: '**** xxxx xx--'
  notes: 'User input required: Enter timeout duration in seconds converted to hex
    (e.g. 0E10 = 3600s / 1hr; factory default is 1194 = 4500s / 75 min). Keep factory
    value unless customizing.'
  type: continuous
  unit: seconds
  feature_name: Power_Point_Maxtime_Cfg (PPMC)
  instruction: Seconds converted to Hex (Stock is 1194-75 minutes)
  user_input: required
