title: DRL - Full Brightness with Headlamps On
raw_community_title: ⚡ [Lightning] DRL - Full Brightness with Headlamps On
category: Lighting
platform: F-150 Lightning
model_years: 2022-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Lighting] [Years: 2022-2026] [Original Title: DRL Brightness Adjustment]

  Affects the DRL lamp between the top and bottom headlamps (not the grille light
  bar on XLT and above).

  example values are 64 =100%, 4B =75%, 32 = 50%, 19 = 25%, 0A =10% (default).'
steps:
- module: BCM
  address: 726-42-01
  targets:
  - mask: x*xx xxxx xx--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 2
      action: 0
      feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
      aliases:
      - LF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: LFDRLLCUC DRL_POSITION
      state_aliases:
      - Not Used
    - bit: 1
      action: 1
      feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
      aliases:
      - LF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: LFDRLLCUC DRL_POSITION
      state_aliases:
      - DRL Position
    - bit: 0
      action: 0
      feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
      aliases:
      - LF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: LFDRLLCUC DRL_POSITION
      state_aliases:
      - Not Used
  - mask: xxx* xxxx xx--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 2
      action: 0
      feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
      aliases:
      - RF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: RFDRLLCUC DRL_POSITION
      state_aliases:
      - Not Used
    - bit: 1
      action: 1
      feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
      aliases:
      - RF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: RFDRLLCUC DRL_POSITION
      state_aliases:
      - DRL Position
    - bit: 0
      action: 0
      feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
      aliases:
      - RF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: RFDRLLCUC DRL_POSITION
      state_aliases:
      - Not Used
recipe_version: '1.1'
