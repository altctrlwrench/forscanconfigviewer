title: Disables chime for Passenger seatbelt
raw_community_title: Disables chime for Passenger seatbelt
category: General
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'FORScan Menu: Belt Minder Chime - Row 1 Col 5 (Set to Disabled. Also can be
  done using procedure in user manual)

  Trim: All [Confirmed: craigc (7/31/24) Lariat FX4]'
steps:
- module: IPC
  address: 720-13-01
  notes: '* Bit 1 (subtract 1 to disable, e.g. change 1 to 0)

    FORScan Menu: Belt Minder Chime - Row 1 Col 5 (Set to Disabled. Also can be done
    using procedure in user manual)

    Trim: All [Confirmed: craigc (7/31/24) Lariat FX4]'
  targets:
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 0
      action: 0
recipe_version: '1.1'
