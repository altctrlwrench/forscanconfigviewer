title: Silent Mode / Police Dark Car Mode
raw_community_title: 2021-26 Silent Mode - adds toggle in Sync under Settings, Vehicle
  (prevents any approach lighting, lock/unlock lighting, courtesy lights until truck
  is turned on)
category: Lighting
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: 'add 1 to current value (if C, make D) Note: reset APIM after change if toggle
  doesn''t show (forscan wrench icon)'
steps:
- module: APIM
  address: 7D0-09-02
  notes: 'add 1 to current value (if C, make D) Note: reset APIM after change if toggle
    doesn''t show (forscan wrench icon)'
  targets:
  - mask: '*xxx xxxx xx--'
    offset_hint: '+1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature: Silent Mode Control Function (SMCF)
recipe_version: '1.1'
