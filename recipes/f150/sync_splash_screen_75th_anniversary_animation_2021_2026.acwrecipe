title: Sync Splash Screen - 75th Anniversary Animation
raw_community_title: Enable 75th Anniversary Splash Screen
category: Sync and Infotainment
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: 'Requires Sync ver 22012 or higher - reset APIM in FORScan after either/both
  changes. other screen available

  Other options available such as 03 for Raptor, 04 for Black Label, 05 for Presidential,
  1A for Dark Horse animation, ~40 in total.'
steps:
- module: APIM
  address: 7D0-03-01
  notes: Requires Sync ver 22012 or higher - reset APIM in FORScan after either/both
    changes
  targets:
  - mask: xxxx *xxx xx--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 2
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 1
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS F150
      state_aliases:
      - SS Continental
    - bit: 0
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
  - mask: xxxx x*xx xx--
    community_hex: '4'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 2
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Black Label
      state_aliases:
      - SS Continental
    - bit: 1
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 0
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
recipe_version: '1.1'
