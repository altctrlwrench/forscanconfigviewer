title: Lincoln Style Autofold Mirrors
raw_community_title: (2021-2023) Mirrors - Lincoln Autofold
category: Windows and Mirrors
platform: F-150
model_years: 2021-2023
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: 'Link for explanation of regular autofold vs Lincoln autofold https://www.f150forum.com/f129/forscan-14th-gen-f150s-481816/index51/#post6947182

  Note: the tradeoff of using Lincoln Autofold is that puddle lights won''t work

  Reverse Tile also enabled'
steps:
- module: DDM
  address: 740-03-16
  notes: click here for an explanation of regular autofold vs Lincoln autofold
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Lincoln Style Autofold Mirrors
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Lincoln Style Autofold Mirrors
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Lincoln Style Autofold Mirrors
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: Lincoln Style Autofold Mirrors
      target_state: Disabled
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: Mirror_Folding_Cfg
      aliases:
      - Mirror_Folding_Cfg (MFC)
      target_state: MFC AUTOFOLD_2/auto foldable mirror for lincoln vehicles
      state_aliases:
      - MFC AUTOFOLD_1/auto foldable mirror for non-lincoln vehicles
    - bit: 0
      action: 1
      feature_name: Mirror_Folding_Cfg
      aliases:
      - Mirror_Folding_Cfg (MFC)
      target_state: MFC AUTOFOLD_2/auto foldable mirror for lincoln vehicles
      state_aliases:
      - MFC AUTOFOLD_2/auto foldable mirror for lincoln vehicles
- module: PDM
  address: 741-03-16
  notes: 'Note: the tradeoff of using Lincoln Autofold is that puddle lights won''t
    work'
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Lincoln Style Autofold Mirrors
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Lincoln Style Autofold Mirrors
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Lincoln Style Autofold Mirrors
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: Lincoln Style Autofold Mirrors
      target_state: Disabled
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: Mirror_Folding_Cfg
      aliases:
      - Mirror_Folding_Cfg (MFC)
      target_state: MFC AUTOFOLD_2/auto foldable mirror for lincoln vehicles
      state_aliases:
      - MFC AUTOFOLD_1/auto foldable mirror for non-lincoln vehicles
    - bit: 0
      action: 1
      feature_name: Mirror_Folding_Cfg
      aliases:
      - Mirror_Folding_Cfg (MFC)
      target_state: MFC AUTOFOLD_2/auto foldable mirror for lincoln vehicles
      state_aliases:
      - MFC AUTOFOLD_2/auto foldable mirror for lincoln vehicles
- module: APIM
  address: 7D0-09-01
  targets:
  - mask: xxxx xx*x xx--
    community_hex: A
    offset_hint: '+4'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Mirrors Autofold (MA)
      target_state: MA Enabled
    - bit: 2
      action: 1
      feature_name: Mirrors Reverse Tilt (MRT)
      target_state: MRT Enabled
recipe_version: '1.1'
