source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Sync and Infotainment] [Years: 2022-2026] [Original Title: Heated
  Steering Wheel Temperature Setpoint]

  Default is B (35°C / 95°F). Values: 0=24°C, 1=25°C, 2=26°C, 3=27°C, 4=28°C, 5=29°C,
  6=30°C, 7=31°C, 8=32°C, 9=33°C, A=34°C, B=35°C (target), C=36°C, D=37°C, E=38°C,
  F=39°C.'
steps:
- module: SCCM
  address: 724-06-01
  targets:
  - mask: '*xxx xxxx xx--'
    community_hex: B
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: HSW_Level_3_TempSetPt (HSWLTSP)
      target_state: HSWLTSP 32°C
    - bit: 2
      action: 0
      feature_name: HSW_Level_3_TempSetPt (HSWLTSP)
      target_state: HSWLTSP 24°C
    - bit: 1
      action: 1
      feature_name: HSW_Level_3_TempSetPt (HSWLTSP)
      target_state: HSWLTSP 26°C
    - bit: 0
      action: 1
      feature_name: HSW_Level_3_TempSetPt (HSWLTSP)
      target_state: HSWLTSP 25°C
