title: Factory Trailer Brake Controller (TBC) Module Enable
raw_community_title: ⚡ [Lightning] Factory Trailer Brake Controller (TBC) Module Enable
category: Powertrain and Drivetrain
platform: F-150 Lightning
model_years: 2022-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Powertrain and Drivetrain] [Years: 2022-2026] [Original Title:
  2021-26 - Adding OEM Trailer Brake Controller (Lightning)]

  Enables the factory Trailer Brake Controller (TBC) module on F-150 Lightning using
  Group C IPMA definitions. Tailored for EV powertrain.'
steps:
- module: BCM
  address: 726-69-02
  targets:
  - mask: xxxx x*xx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
      feature: TBM_Available_Cfg (TBMAC)
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
      feature: TRM_Available_Cfg (TRMAC)
- module: APIM
  address: 7D0-09-03
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '4'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature: Trailer Brake Controller (TBC)
- module: IPMA
  address: 706-18-01
  targets:
  - mask: xxxx xxx* xx--
    community_hex: C
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature: VehicleInfo_TrailerLightModule (VITLM)
    - bit: 2
      action: 1
      feature: VehicleInfo_TrailerBrakeModule (VITBM)
recipe_version: '1.1'
