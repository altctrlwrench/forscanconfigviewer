title: Trailer Side View Camera on Turn Signal
raw_community_title: ⚡ [Lightning] Trailer Side View Camera on Turn Signal
category: Cameras and ADAS
platform: F-150 Lightning
model_years: 2022-2023
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Cameras and ADAS] [Years: 2022-2023] [Original Title: Trailer Side
  View]

  Shows corresponding camera view alongside vehicle when turn signal is applied with
  trailer connected. Standard on 2024+. Requires 12/23 IPMA update.'
steps:
- module: IPMA
  address: 706-01-02
  targets:
  - mask: '*xxx xxxx xx--'
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature: ModuleFeatureCfg_TurnSgnlView (MFCTSV)
    - bit: 0
      action: 1
      feature: ModuleFeatureCfg_TurnSgnlView (MFCTSV)
- module: APIM
  address: 7D0-02-03
  targets:
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature: Turn Signal Views (TSV)
recipe_version: '1.1'
