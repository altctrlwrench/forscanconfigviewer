title: Keyfob Panic Button Activation Mode
raw_community_title: Keyfob Panic Button
category: Locks and Security
platform: Bronco
model_years: 2021-2024
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2022 Bronco.xlsx
notes: '0=disabled, 1=2 clicks, 2=one click (default)

  Confirmed: nottinbe/multi'
steps:
- module: BDYCM
  address: 726-62-01
  mask: x*xx xxxx xx--
  notes: set to 2 clicks
  nibble: 1
  community_instruction: set to 2 clicks
  bits:
  - bit: 3
    action: 0
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DISABLE
  - bit: 2
    action: 0
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DISABLE
  - bit: 1
    action: 0
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DISABLE
  - bit: 0
    action: 1
    feature_name: PanicActivate_Cfg (PAC)
    target_state: PAC DOUBLE
