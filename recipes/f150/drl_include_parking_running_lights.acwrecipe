validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
steps:
- module: BCM
  address: 726-38-01
  mask: xxxx xxxx **--
  nibbles:
  - nibble: 8
    recommended_hex: '0'
    community_instruction: will turn on rear tails with DRLs
    feature_name: DRL_IncludeParklamps_Cfg
    target_state: Disable
    bit: 3
    action: 0
  - nibble: 9
    recommended_hex: '1'
    community_instruction: will turn on rear tails with DRLs
    feature_name: DRL_IncludeParklamps_Cfg (DRLIPC)
    target_state: DRLIPC DISABLE
    bit: 3
    action: 0
