title: Pro Power Onboard with Vehicle Off
raw_community_title: ⚡ [Lightning] Pro Power Onboard with Vehicle Off
category: Powertrain and Drivetrain
platform: F-150 Lightning
model_years: 2022-2023
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Powertrain and Drivetrain] [Years: 2022-2023] [Original Title:
  Enable Pro Power Onboard with truck off (2022-2023 only. Standard on 2024+)]

  Creates a Sync toggle in the Pro Power settings screen. Requires a 2025 or later
  PCM update (via FDRS) or early 2026 Charge Port OTAs (PT-25.13.12 or PT-25.8.5 depending
  on model year).'
steps:
- module: APIM
  address: 7D0-10-03
  targets:
  - mask: xxxx xx*x xx--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: PPO Outlets On in Vehicle Off State (PPOOOVOS)
      aliases:
      - Pro Power Onboard with Vehicle Off
      target_state: Enabled
- module: APIM
  address: 7D0-10-04
  targets:
  - mask: xxx* xxxx xx--
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: PPO Utility Idle (PPOUI)
      target_state: PPOUI Version 2 (MY24 and beyond)
recipe_version: '1.1'
