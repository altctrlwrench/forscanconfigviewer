title: Sync Splash Screen - F-150 Lightning Animation
raw_community_title: ⚡ [Lightning] Sync Splash Screen - F-150 Lightning Animation
category: Sync and Infotainment
platform: F-150 Lightning
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Sync and Infotainment] [Years: 2021-2026] [Original Title: Enable
  Lightning F150 Splash Screen]

  No target setting in As Built Pro. Use 1F for Lightning. 38 other options available
  (Anniversary, Black Label, Presidential, etc), check sheets for variants.'
steps:
- module: APIM
  address: 7D0-03-01
  targets:
  - mask: xxxx *xxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Stock Ford/Lincoln Splash Screen, as determined by brand bit
    - bit: 2
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Stock Ford/Lincoln Splash Screen, as determined by brand bit
    - bit: 1
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Stock Ford/Lincoln Splash Screen, as determined by brand bit
    - bit: 0
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Stock Ford/Lincoln Splash Screen, as determined by brand bit
  - mask: xxxx x*xx xx--
    community_hex: F
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Navigator
      state_aliases:
      - SS Continental
    - bit: 2
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Navigator
      state_aliases:
      - SS Continental
    - bit: 1
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Navigator
      state_aliases:
      - SS Continental
    - bit: 0
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Navigator
recipe_version: '1.1'
