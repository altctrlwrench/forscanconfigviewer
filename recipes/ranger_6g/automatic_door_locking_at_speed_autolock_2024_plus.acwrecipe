title: Automatic Door Locking at Speed (Autolock)
raw_community_title: Auto lock doors at speed
category: Locks and Security
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'FORScan Menu: Auto Lock - Initial Value, Personal 1-4,  and Vehicle (Enabled
  (Default NA), Disabled)

  Confirmed: raptortugal (2/17/2025)

  * Bit4 (add 8 to enable)

  FORScan Menu: Auto Lock Control Function (Disabled (Default NA), Enabled)

  Confirmed: raptortugal (2/17/2025)

  * -> Bit 3 (add 4 to enable (if currently disabled)

  FORScan Menu: Locking Feedback Audible (optional) (Enabled (Default NA), Disabled)

  Confirmed: raptortugal (2/17/2025)

  * -> Bit 2 (add 2 to enable) (if currently disabled)

  FORScan Menu: Locking Feedback Visual (optional) (Disabled (Default NA), Enabled)

  Confirmed: raptortugal (2/17/2025)'
steps:
- module: BCM
  address: 724-19-02
  notes: '* -> set to 1 (e.g. 0101 0101 01--)

    FORScan Menu: Auto Lock - Initial Value, Personal 1-4,  and Vehicle (Enabled (Default
    NA), Disabled)

    Confirmed: raptortugal (2/17/2025)'
  targets:
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
  - mask: xxx* xxxx xx--
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
  - mask: xxxx xxx* xx--
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
  - mask: xxxx xxxx x*--
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
- module: APIM
  address: 7D0-09-01
  notes: '* Bit4 (add 8 to enable)

    FORScan Menu: Auto Lock Control Function (Disabled (Default NA), Enabled)

    Confirmed: raptortugal (2/17/2025)'
  targets:
  - mask: xx*x xxxx xx--
    offset_hint: '+8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature: Autolock Control Function (ACF)
- module: IPC
  address: 720-06-01
  notes: '* -> Bit 3 (add 4 to enable (if currently disabled)

    FORScan Menu: Locking Feedback Audible (optional) (Enabled (Default NA), Disabled)

    Confirmed: raptortugal (2/17/2025)'
  targets:
  - mask: xxxx *xxx xx--
    offset_hint: '+4'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature: Locking Feedback Audible (LFA)
- module: IPC
  address: 720-06-01
  notes: '* -> Bit 2 (add 2 to enable) (if currently disabled)

    FORScan Menu: Locking Feedback Visual (optional) (Disabled (Default NA), Enabled)

    Confirmed: raptortugal (2/17/2025)'
  targets:
  - mask: xxxx *xxx xx--
    offset_hint: '+2'
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature: Locking Feedback Visual (LFV)
recipe_version: '1.1'
