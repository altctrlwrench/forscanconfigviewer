title: Sync Climate Bar - Heated & Cooled Seat Icons
raw_community_title: Enable Cooled and/or Heated Seats to Climate Bar
category: Sync and Infotainment
platform: Super Duty
model_years: 2023-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2023 Super Duty.xlsx
steps:
- module: APIM
  address: 7D0-02-01
  mask: xxxx x*xx xx--
  nibble: 5
  community_instruction: if you have heated & cooled seats then use A
  feature_name: Heated Seats HMI (HSHMI)
  target_state: HSHMI Heated and Cooled
  bit: 3
  action: 1
