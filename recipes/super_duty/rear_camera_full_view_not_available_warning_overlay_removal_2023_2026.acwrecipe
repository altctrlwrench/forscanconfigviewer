title: Rear Camera 'Full View Not Available' Warning Overlay Removal
raw_community_title: Remove Black Box when rear camera on while driving
category: Cameras and ADAS
platform: Super Duty
model_years: 2023-2026
trim: All
source_sheet: 2023-2026 Super Duty Common Items.xlsx
notes: Add 1 to Current Value - Sync version must be 23151 rev 902 or higher
steps:
- module: APIM
  address: 7D0-02-02
  notes: Add 1 to Current Value - Sync version must be 23151 rev 902 or higher
  targets:
  - mask: xxx* xxxx xx--
    offset_hint: '+1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: RCOD HMI w/o Blackbox (RCODHMIB)
      target_state: RCODHMIB Enabled
recipe_version: '1.1'
