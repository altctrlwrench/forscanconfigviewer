title: Sync Splash Screen - 75th Anniversary Animation
raw_community_title: Enable 75th Anniversary Splash Screen
category: Sync and Infotainment
platform: Super Duty
model_years: 2023-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2023 Super Duty.xlsx
notes: 'No options set for webpage. Set to 24 for 75th.

  Multiple options such as default, presidential (05), black label (04), Europe (0A),
  etc. (check sheet for values)'
steps:
- module: APIM
  address: 7D0-03-01
  mask: xxxx **xx xx--
  notes: 'Target hex: 24 (75th Anniversary animation). Requires Sync ver 22012 or
    higher.'
  recommended_hex: '24'
  target_state: 75th Anniversary Splash Screen
  nibbles:
  - nibble: 4
    recommended_hex: '2'
    feature_name: Visual Design Variants (VDV) / Splash Animation Brand
    target_state: 75th Anniversary (High Nibble)
  - nibble: 5
    recommended_hex: '4'
    feature_name: Visual Design Variants (VDV) / Splash Animation Brand
    target_state: 75th Anniversary (Low Nibble)
