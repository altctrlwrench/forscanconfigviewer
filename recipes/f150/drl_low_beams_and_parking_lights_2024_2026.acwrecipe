title: DRL - Low Beams and Parking Lights
raw_community_title: Low Beams & Parking Lamps as DRL (2024-2026) - see this post
  for pics
category: Lighting
platform: F-150
model_years: 2024-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: DRL_IncludeParklamps_Cfg https://www.f150forum.com/f129/forscan-14th-gen-f150s-481816/index330/#post7599368
steps:
- module: BCM
  address: 726-38-01
  notes: DRL_IncludeParklamps_Cfg
  targets:
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: DRL_IncludeParklamps_Cfg (DRLIPC)
      aliases:
      - DRL_IncludeParklamps_Cfg
      target_state: DRLIPC ENABLE
      state_aliases:
      - Enable
- module: BCM
  address: 726-38-02
  notes: DRL_WithTurn_Cfg
  targets:
  - mask: xxx* xxxx xx--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: DRL_WithTurn_Cfg (DRLWTC)
      aliases:
      - DRL_WithTurn_Cfg
      target_state: DRLWTC ALLOW
      state_aliases:
      - Allow
    - bit: 0
      action: 0
      feature_name: DRL_WithTurn_Cfg (DRLWTC)
      aliases:
      - DRL_WithTurn_Cfg
      target_state: DRLWTC ALLOW
      state_aliases:
      - Allow
- module: BCM
  address: 726-41-02
  notes: LowBeam_Cfg
  targets:
  - mask: xxx* xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: LowBeam_Cfg (LBC)
      aliases:
      - LowBeam_Cfg
      target_state: LBC LOWBEAM_WITH_DRL
      state_aliases:
      - Low Beam With DRL
- module: BCM
  address: 726-42-02
  notes: LF/RF_Low_Beam_Ckt_Usage_Cfg
  targets:
  - mask: xxx* xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: LF_Low_Beam_Ckt_Usage_Cfg (LFLBCUC)
      aliases:
      - LF_Low_Beam_Ckt_Usage_Cfg
      target_state: LFLBCUC NOT_USED
      state_aliases:
      - Not Used
    - bit: 0
      action: 1
      feature_name: LF_Low_Beam_Ckt_Usage_Cfg (LFLBCUC)
      aliases:
      - LF_Low_Beam_Ckt_Usage_Cfg
      target_state: LFLBCUC LOW_DRL
      state_aliases:
      - Low DRL
  - mask: xxxx x*xx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: RF_Low_Beam_Ckt_Usage_Cfg (RFLBCUC)
      aliases:
      - RF_Low_Beam_Ckt_Usage_Cfg
      target_state: RFLBCUC NOT_USED
      state_aliases:
      - Not Used
    - bit: 0
      action: 1
      feature_name: RF_Low_Beam_Ckt_Usage_Cfg (RFLBCUC)
      aliases:
      - RF_Low_Beam_Ckt_Usage_Cfg
      target_state: RFLBCUC LOW_DRL
      state_aliases:
      - Low DRL
- module: BCM
  address: 726-43-02
  notes: DRL_OnWithParkLampsOn_Cfg
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: DRL_OnWithParkLampsOn_Cfg (DRLOWPLOC)
      aliases:
      - OutageABM_Cfg (OABMC)
      - OutageABM_Cfg
      target_state: DRLOWPLOC ENABLE
recipe_version: '1.1'
