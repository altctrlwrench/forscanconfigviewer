title: Front Turn Signal Bulb Outage Detection
raw_community_title: Front Turn Bulb Outage Detection
category: Lighting
platform: Super Duty
model_years: 2023-2026
trim: All
source_sheet: 2023-2026 Super Duty Common Items.xlsx
notes: 0=No Outage 1=Outage - set to 0 for LED
steps:
- module: BdyCm-BCM
  address: 726-40-02
  notes: 0=No Outage 1=Outage - set to 0 for LED
  targets:
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: Front_Bulb_Turn_Outage_Cfg (FBTOC)
      aliases:
      - Front_Bulb_Turn_Outage_Cfg
      target_state: FBTOC NO_OUTAGE
      state_aliases:
      - No Outage
recipe_version: '1.1'
