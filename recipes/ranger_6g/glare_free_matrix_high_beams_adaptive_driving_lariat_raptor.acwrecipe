- module: APIM
  address: 7D0-09-01
  mask: x*xx xxxx xx--
  notes: '1=GFHB, 3=OEM (Default)

    Disables Auto High Beam Control Function'
  nibbles:
  - nibble: 1
    bits:
    - bit: 1
      action: 0
      feature_name: Auto High Beam Control Function (AHBCF)
      target_state: AHBCF Disabled
    - bit: 0
      action: 1
      feature_name: Autolamp Delay (AD)
      target_state: AD Enabled
    notes: '1=GFHB, 3=OEM (Default)

      Disables Auto High Beam Control Function'
- module: APIM
  address: 7D0-09-03
  mask: xx*x xxxx xx--
  notes: '8=GFHB, 4=OEM (Default)

    Changes APIM display from Auto High Beam to Glare Free High Beam'
  community_instruction: '8=GFHB, 4=OEM (Default)

    Changes APIM display from Auto High Beam to Glare Free High Beam'
  nibbles:
  - nibble: 2
    bits:
    - bit: 3
      action: 1
      feature_name: Auto High Beam Menu (AHBM)
      target_state: AHBM Glare free High Beams
    - bit: 2
      action: 0
      feature_name: Auto High Beam Menu (AHBM)
      target_state: AHBM Disabled
    notes: '8=GFHB, 4=OEM (Default)

      Changes APIM display from Auto High Beam to Glare Free High Beam'
