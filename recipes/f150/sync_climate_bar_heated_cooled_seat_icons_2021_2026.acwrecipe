title: Sync Climate Bar - Heated & Cooled Seat Icons
raw_community_title: Enable Cooled and/or Heated seats to climate bar above
category: Sync and Infotainment
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: if you have heated & cooled seats  then use A
steps:
- module: APIM
  address: 7D0-02-01
  notes: if you have heated & cooled seats  then use A
  targets:
  - mask: xxxx x*xx xx--
    offset_hint: '+4'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature: Heated Seats HMI (HSHMI)
    - bit: 2
      action: 0
      feature: Heated Seats HMI (HSHMI)
recipe_version: '1.1'
