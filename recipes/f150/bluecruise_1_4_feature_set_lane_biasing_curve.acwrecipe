title: BlueCruise 1.4 Feature Set (Lane Biasing & Curve Speed)
raw_community_title: Bluecruise 1.4 Settings   (IPMA strategy must be on ACJ or BBC
  for this to work)
category: Cameras and ADAS
platform: F-150
model_years: 2021-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
steps:
- module: APIM
  address: 7D0-09-05
  mask: xxxx xx*x *x--
  nibbles:
  - nibble: 6
    recommended_hex: '4'
    community_instruction: Lane Biasing (Under Cruise Control), Predictive Speed Assist
      (Under Cruise Control)
    feature_name: Lane Biasing (LB)
    target_state: LB Enabled
    bit: 2
    action: 1
  - nibble: 8
    recommended_hex: '2'
    community_instruction: Lane Biasing (Under Cruise Control), Predictive Speed Assist
      (Under Cruise Control)
    feature_name: Curve Speed Control Menu (CSCM)
    target_state: CSCM Enabled
    bit: 2
    action: 1
- module: APIM
  address: 7D0-10-02
  mask: xxxx xxxx *x--
  nibble: 8
  recommended_hex: '1'
  community_instruction: Lane Change Assist (under Cruise Control)
  feature_name: Assisted Lane Change  (ALC)
  target_state: ALC Enabled
  bit: 0
  action: 1
- module: IPMA
  address: 706-01-01
  mask: x*xx xxxx xx--
  nibble: 1
  recommended_hex: E
  community_instruction: MFCLKS LKAlert+LKAid+LCWA
  feature_name: ModuleFeatureCfg_LKS (MFCLKS)
  target_state: MFCLKS LKAlert+LKAid
  bit: 3
  action: 1
- module: IPMA
  address: 706-01-02
  mask: x*xx xxxx xx--
  nibble: 1
  recommended_hex: '5'
  community_instruction: ModuleFeatureCfg_ALB (MFCALB)&ModuleFeatureCfg_ALC (MFCALC)
  feature_name: ModuleFeatureCfg_ALB (MFCALB)
  target_state: MFCALB Enabled
  bit: 2
  action: 1
- module: IPMA
  address: 706-02-02
  mask: xxxx xxxx x*--
  type: continuous
  feature_name: FeatureCfg_BA_DefaultMode
  instruction: Lane Biasing (Under Cruise Control), Predictive Speed Assist (Under
    Cruise Control)
- module: IPMA
  address: 706-38-01
  mask: x*x* xxxx xx--
  nibbles:
  - nibble: 1
    recommended_hex: '8'
    community_instruction: CustomerSetting_ALBSelected_Vehicle (CSALBSV),  CustomerSetting_ALCSelected_Vehicle
      (CSALCSV)
    feature_name: CustomerSetting_ALBSelected_Vehicle (CSALBSV)
    target_state: CSALBSV On
    bit: 3
    action: 1
  - nibble: 3
    recommended_hex: '8'
    community_instruction: CustomerSetting_ALBSelected_Vehicle (CSALBSV),  CustomerSetting_ALCSelected_Vehicle
      (CSALCSV)
    feature_name: CustomerSetting_ALCSelected_Vehicle (CSALCSV)
    target_state: CSALCSV On
    bit: 3
    action: 1
