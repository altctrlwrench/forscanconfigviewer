title: Passenger Seatbelt Warning Chime Disable
raw_community_title: Disables chime for Passenger seatbelt
category: Chimes and Horn
platform: Ranger (6G)
model_years: 2024+
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'FORScan Menu: Belt Minder Chime - Row 1 Col 5 (Set to Disabled. Also can be
  done using procedure in user manual)

  Trim: All [Confirmed: craigc (7/31/24) Lariat FX4]'
forscan_menu: Belt Minder Chime - Row 1 Col 5 (Set to Disabled. Also can be done using
  procedure in user manual)
steps:
- module: IPC
  address: 720-13-01
  mask: x*xx xxxx xx--
  notes: Set all masked nibbles to 0 to disable seatbelt chimes and warning notifications.
  hex_offset: '-1'
  community_instruction: Bit 1 (subtract 1 to disable, e.g. change 1 to 0)
  target_state: All Seatbelt Warnings Disabled
  type: all_zeros
  nibbles:
  - nibble: 1
    recommended_hex: '0'
