title: Cameras at Speed (Front & 360 View in Motion)
raw_community_title: Enable Cameras at Speed
category: Cameras and ADAS
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
steps:
- module: IPMA
  address: 706-02-02
  targets:
  - mask: xxx* xxxx xx--
    community_hex: F
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: FeatureCfg_DPAC_ViewCtlAtSpeed_Hitch (FCDPACVCASH)
      target_state: FCDPACVCASH Enabled
    - bit: 2
      action: 1
      feature_name: FeatureCfg_DPAC_ViewCtlAtSpeed_Aux (FCDPACVCASA)
      target_state: FCDPACVCASA Enabled
    - bit: 1
      action: 1
      feature_name: FeatureCfg_DPAC_ViewCtlAtSpeed_CHMSL (FCDPACVCASCHMSL)
      target_state: FCDPACVCASCHMSL Enabled
    - bit: 0
      action: 1
      feature_name: FeatureCfg_DPAC_ViewCtlAtSpeed_RCOD (FCDPACVCASRCOD)
      target_state: FCDPACVCASRCOD Enabled
  - mask: xxxx *xxx xx--
    community_hex: C
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: FeatureCfg_TBA_HitchView (FCTBAHV)
      target_state: FCTBAHV Enabled
  - mask: xxxx x*xx xx--
    community_hex: E
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: FeatureCfg_DPAC_ViewCtlAtSpeed (FCDPACVCAS)
      target_state: FCDPACVCAS Enabled
- module: APIM
  address: 7D0-01-01
  targets:
  - mask: xxxx xxxx *x--
    community_hex: F
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Rear Camera (RC)
      target_state: RC Rear Camera Present
  - mask: xxxx xxxx x*--
    community_hex: D
    type: discrete
- module: APIM
  address: 7D0-01-04
  notes: use FF if you have 1-pedal drive
  targets:
  - mask: xxxx *xxx xx--
    community_hex: F
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature_name: Hitch View (HV)
      target_state: HV Enabled
    - bit: 1
      action: 1
      feature_name: CHMSL View at Speed (CHMSLVS)
      target_state: CHMSLVS Enabled
    - bit: 0
      action: 1
      feature_name: Aux View at Speed (AVS)
      target_state: AVS Enabled
  - mask: xxxx x*xx xx--
    community_hex: D
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: RCOD View at Speed (RCODVS)
      target_state: RCODVS Enabled
    - bit: 2
      action: 1
      feature_name: Hitch View at Speed (HVS)
      target_state: HVS Enabled
    - bit: 0
      action: 1
      feature_name: Off road Views at Speed (OVS)
      target_state: OVS Enabled
recipe_version: '1.1'
