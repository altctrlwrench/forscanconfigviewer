    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
      feature: Feat_Cfg [SILENTMODE] [VEHICLE] (SILENTMODE_VEHICLE)
- module: BCM
  address: 726-28-02
  targets:
