title: Front Turn Signal Bulb Outage Detection
raw_community_title: Front Turn Bulb Outage Detection (2021-2026)
category: Lighting
platform: F-150
model_years: 2021-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
steps:
- module: BCM
  address: 726-40-02
  mask: '**xx xxxx xx--'
  nibbles:
  - nibble: 0
    community_instruction: 00=No Outage 01=Outage - set to no outage when upgrading
      to LED
    feature_name: Front_Bulb_Turn_Outage_Cfg
    target_state: No Outage
    bit: 3
    action: 0
  - nibble: 1
    community_instruction: 00=No Outage 01=Outage - set to no outage when upgrading
      to LED
    feature_name: Front_Bulb_Turn_Outage_Cfg (FBTOC)
    target_state: FBTOC NO_OUTAGE
    bit: 3
    action: 0
