title: 360 Degree Camera View Display Sizing Fix
raw_community_title: ⚡ [Lightning] 360 Degree Camera View Display Sizing Fix
category: Cameras and ADAS
platform: F-150 Lightning
model_years: '2022'
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Cameras and ADAS] [Years: 2022] [Original Title: Fix Small 360
  degree camera view]

  Resolves aspect ratio display issue seen on some 2022 models after IPMA updates.'
steps:
- module: APIM
  address: 7D0-01-04
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '3'
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: 360 Camera View Format (CVF)
      target_state: CVF Reserved
      state_aliases:
      - CVF Reserved
    - bit: 0
      action: 1
      feature_name: 360 Camera View Format (CVF)
      target_state: CVF Reserved
recipe_version: '1.1'
