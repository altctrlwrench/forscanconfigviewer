title: Global Windows Remote Open/Close Enable
raw_community_title: 'Enable Global Windows Close


  https://www.explorerst.org/threads/global-windows

  -close-enable-2025-explorer.9064/'
category: General
platform: Explorer
model_years: 2020-2026
trim: All
source_sheet: 2020-2024 Explorer.xlsx
notes: "[BCM] - - Enable the following from DISABLED to ENABLED in BdyCM (easy way):\
  \ \n-Global Close (change from Disabled to Remote)**\n-Global Close - Vehicle\n\
  -Global Close - Initial Value\n-Global Close - Personal 1\n-Global Close - Personal\
  \ 2\n-Global Close - Personal 3\n-Global Close - Personal 4\n\nSource Reference:\
  \ https://www.explorerst.org/threads/global-windows"
steps:
- module: PDM
  address: 741-06-02
  notes: "[BCM] - - Enable the following from DISABLED to ENABLED in BdyCM (easy way):\
    \ \n-Global Close (change from Disabled to Remote)**\n-Global Close - Vehicle\n\
    -Global Close - Initial Value\n-Global Close - Personal 1\n-Global Close - Personal\
    \ 2\n-Global Close - Personal 3\n-Global Close - Personal 4"
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
- module: DDM
  address: 740-06-02
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Global_Close_Cfg (GCC)
      target_state: Enabled
recipe_version: '1.1'
