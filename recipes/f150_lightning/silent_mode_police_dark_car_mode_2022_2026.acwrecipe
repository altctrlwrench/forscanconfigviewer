title: Silent Mode / Police Dark Car Mode
raw_community_title: ⚡ [Lightning] Silent Mode / Police Dark Car Mode
category: Lighting
platform: F-150 Lightning
model_years: 2022-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Lighting] [Years: 2022-2026] [Original Title: Enable Silent Mode
  (AKA campground / dark mode)]

  Creates a SYNC toggle to turn on/off Silent Mode. Enables silent mode. Silent Mode
  turns off cluster lighting, welcome lighting, courtesy lights, and SYNC screen when
  opening doors; also silences the horn when locking doors.'
steps:
- module: BCM
  address: 726-25-02
  targets:
  - mask: '*xxx xxxx xx--'
    community_hex: '0'
    type: discrete
  - mask: x*xx xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [SILENTMODE] [PERS_1] (SILENTMODE_PERS_1)
      aliases:
      - Feat_Cfg [SILENTMODE] [PERS_1]
      target_state: SILENTMODE_PERS_1 ENABLE
      state_aliases:
      - Enable
  - mask: xx*x xxxx xx--
    community_hex: '0'
    type: discrete
  - mask: xxx* xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [SILENTMODE] [PERS_2] (SILENTMODE_PERS_2)
      aliases:
      - Feat_Cfg [SILENTMODE] [PERS_2]
      target_state: SILENTMODE_PERS_2 ENABLE
      state_aliases:
      - Enable
  - mask: xxxx *xxx xx--
    community_hex: '0'
    type: discrete
  - mask: xxxx x*xx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [SILENTMODE] [PERS_3] (SILENTMODE_PERS_3)
      aliases:
      - Feat_Cfg [SILENTMODE] [PERS_3]
      target_state: SILENTMODE_PERS_3 ENABLE
      state_aliases:
      - Enable
  - mask: xxxx xx*x xx--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [SILENTMODE] [PERS_4] (SILENTMODE_PERS_4)
      aliases:
      - Feat_Cfg [SILENTMODE] [PERS_4]
      target_state: SILENTMODE_PERS_4 ENABLE
      state_aliases:
      - Enable
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [SILENTMODE] [VEHICLE] (SILENTMODE_VEHICLE)
      aliases:
      - Feat_Cfg [SILENTMODE] [VEHICLE]
      target_state: SILENTMODE_VEHICLE ENABLE
      state_aliases:
      - Enable
- module: BCM
  address: 726-28-02
  targets:
  - mask: '*xxx xxxx xx--'
    community_hex: '0'
    type: discrete
  - mask: x*xx xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: FeatLst_to_BCM_Feature_InitVal [SILENTMODE] (SILENTMODE)
      aliases:
      - FeatLst_to_BCM_Feature_InitVal [SILENTMODE]
      target_state: SILENTMODE ENABLE
      state_aliases:
      - SILENTMODE ENABLED
      - Enable
- module: APIM
  address: 7D0-09-02
  targets:
  - mask: '*xxx xxxx xx--'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Silent Mode Control Function (SMCF)
      target_state: SMCF Enabled
recipe_version: '1.1'
