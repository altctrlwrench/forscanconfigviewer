title: Global Windows Remote Open/Close Enable
raw_community_title: Global Windows Open/Close
category: Windows and Mirrors
platform: Bronco
model_years: 2021+
trim: All
source_sheet: 2021+ Bronco Common Items.xlsx
notes: 'To roll down windows press unlock button on fob and then press again and hold

  To roll up windows press lock button on fob and then press again and hold

  Confirmed: Bigmoose/multi

  Optional: E - Add Global Window Open/Close to Sybc 4 settings menu'
steps:
- module: DDM
  address: 740-06-02
  notes: 'To roll down windows press unlock button on fob and then press again and
    hold

    To roll up windows press lock button on fob and then press again and hold'
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Global_Close_Cfg (GCC)
      target_state: GCC ENABLED
- module: PDM
  address: 741-06-02
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
- module: DDM
  address: 740-06-03
  targets:
  - mask: '*xxx xxxx xx--'
    community_hex: '0'
    type: discrete
  - mask: x*xx xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Global_Open_Cfg (GOC)
      target_state: GOC ENABLED
- module: PDM
  address: 741-06-03
  targets:
  - mask: '*xxx xxxx xx--'
    community_hex: '0'
    type: discrete
  - mask: x*xx xxxx xx--
    community_hex: '1'
    type: discrete
- module: BdyCM
  address: 726-11-02
  targets:
  - mask: xx*x xxxx xx--
    community_hex: '0'
    type: discrete
  - mask: xxx* xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: GlobalClose_Cfg (GCC)
      aliases:
      - GlobalClose_Cfg
      target_state: GCC REMOTE
      state_aliases:
      - Remote
  - mask: xxxx xx*x xx--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: GlobalOpen_Cfg (GOC)
      aliases:
      - GlobalOpen_Cfg
      target_state: GOC REMOTE
      state_aliases:
      - Remote
- module: BdyCM
  address: 726-22-01
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [GLOBALCLOSE] [VEHICLE] (GLOBALCLOSE_VEHICLE)
      aliases:
      - Feat_Cfg [GLOBALCLOSE] [VEHICLE]
      target_state: GLOBALCLOSE_VEHICLE ENABLE
      state_aliases:
      - Enable
- module: BdyCM
  address: 726-22-02
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [GLOBALOPEN] [VEHICLE] (GLOBALOPEN_VEHICLE)
      aliases:
      - Feat_Cfg [GLOBALOPEN] [VEHICLE]
      target_state: GLOBALOPEN_VEHICLE ENABLE
      state_aliases:
      - Enable
- module: APIM
  address: 7D0-09-01
  notes: 'Optional: E - Add Global Window Open/Close to Sybc 4 settings menu'
  targets:
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Global Window Open (GWO)
      aliases:
      - Global Window Open (GWO) & Global Window Close (GWC) &  Daytime Running Lamps
        Control Function (DRLCF) & Temporary Mobility Kit (TMK)
      target_state: GWO Enabled
      state_aliases:
      - GWO enabled, GWC disabled, DRLCF disabled, TMK disabled
      - GWO enabled
    - bit: 2
      action: 1
      feature_name: Global Window Close (GWC)
      aliases:
      - Global Window Open (GWO) & Global Window Close (GWC) &  Daytime Running Lamps
        Control Function (DRLCF) & Temporary Mobility Kit (TMK)
      target_state: GWC Enabled
      state_aliases:
      - GWO disabled, GWC enabled, DRLCF disabled, TMK disabled
      - GWC enabled
recipe_version: '1.1'
