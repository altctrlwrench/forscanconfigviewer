title: Seatbelt Warning Chimes Disable (Driver & Passenger)
raw_community_title: Disable Seat Belt Reminder
category: Chimes and Horn
platform: F-150 Lightning
model_years: 2022-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro & Lightning Community
source_sheet: F-150 Lightning FORScan Thread
notes: Disables periodic audible Belt-Minder reminder. Can also be disabled per-seat
  via the Owner's Manual procedure.
steps:
- module: IPC
  address: 720-01-01
  mask: xxxx xx*x xx--
  nibbles:
  - nibble: 6
    recommended_hex: '0'
    community_instruction: Set to 0
    bits:
    - bit: 3
      action: 0
      feature_name: Backup Warning Chime (BWC)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Driver Beltminder (DB)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Pass BeltMinder (PBM)
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: Mid Pass Beltminder (MPB)
      target_state: Disabled
validation_status: validated
