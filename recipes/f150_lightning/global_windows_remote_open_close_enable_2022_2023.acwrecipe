title: Global Windows Remote Open/Close Enable
raw_community_title: ⚡ [Lightning] Global Windows Remote Open/Close Enable
category: Windows and Mirrors
platform: F-150 Lightning
model_years: 2022-2023
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Windows and Mirrors] [Years: 2022-2023] [Original Title: Global
  window open/close using keyfob]

  Only works on the front windows because one-touch is not enabled in the back windows.
  After changes, go into Sync (Settings > Vehicle > Windows) and enable Remote Open
  and/or Remote Close. Open: press and hold unlock on fob for 3+ seconds. Close: press
  and hold lock for 3+ seconds. Cancel: press lock or unlock again.'
steps:
- module: DDM
  address: 740-06-02
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Global Close
      aliases:
      - Global_Open_Cfg (GOC)
      target_state: enabled
- module: PDM
  address: 741-06-02
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Global Close
      target_state: enabled
- module: DDM
  address: 740-06-03
  targets:
  - mask: '*xxx xxxx xx--'
    community_hex: '0'
    type: discrete
  - mask: x*xx xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Global Open
      target_state: enabled
- module: PDM
  address: 741-06-03
  targets:
  - mask: '*xxx xxxx xx--'
    community_hex: '0'
    type: discrete
  - mask: x*xx xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Global Open
      target_state: enabled
- module: BCM
  address: 726-11-02
  targets:
  - mask: xx*x xxxx xx--
    community_hex: '0'
    type: discrete
  - mask: xxx* xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: GlobalClose_Mode_Cfg (GCMC)
      aliases:
      - GlobalClose_Cfg (GCC)
      - GlobalClose_Cfg
      - GlobalClose_Mode_Cfg
      target_state: GCMC PRESS_N_HOLD
      state_aliases:
      - Press_N_Hold
  - mask: xxxx xx*x xx--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: GlobalOpen_Cfg (GOC)
      aliases:
      - GlobalOpen_Cfg
      target_state: GOC REMOTE
      state_aliases:
      - Remote
- module: BCM
  address: 726-22-01
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [GLOBALCLOSE] [VEHICLE] (GLOBALCLOSE_VEHICLE)
      aliases:
      - Feat_Cfg [GLOBALCLOSE] [VEHICLE]
      target_state: GLOBALCLOSE_VEHICLE ENABLE
      state_aliases:
      - Enable
- module: BCM
  address: 726-22-02
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Feat_Cfg [GLOBALOPEN] [VEHICLE] (GLOBALOPEN_VEHICLE)
      aliases:
      - Feat_Cfg [GLOBALOPEN] [VEHICLE]
      target_state: GLOBALOPEN_VEHICLE ENABLE
      state_aliases:
      - Enable
- module: APIM
  address: 7D0-09-01
  targets:
  - mask: xxxx x*xx xx--
    community_hex: E
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Global Window Open (GWO)
      target_state: GWO Enabled
    - bit: 2
      action: 1
      feature_name: Global Window Close (GWC)
      target_state: GWC Enabled
recipe_version: '1.1'
