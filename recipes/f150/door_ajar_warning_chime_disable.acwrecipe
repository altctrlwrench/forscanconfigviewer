steps:
- module: IPC
  address: 720-01-02
  mask: xx*x xx--
  notes: see IPC spreadsheet to disable EIOCM | Engine/Ignition On chime disabled
  nibble: 2
  bits:
  - bit: 1
    action: 0
    feature_name: Engine/Ignition On Chime - Message (EIOCM)
    target_state: EIOCM Disabled
  - bit: 0
    action: 0
    feature_name: Engine/Ignition On Chime - Message (EIOCM)
    target_state: EIOCM Disabled
