title: Rear Turn Signal LED Outage Detection (Hyperflash Disable)
raw_community_title: Rear Turn LED Outage Detection (2021-2026)
category: Lighting
platform: F-150
model_years: 2021-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
steps:
- module: BCM
  address: 726-40-02
  mask: xxxx **xx xx--
  nibbles:
  - nibble: 4
    community_instruction: 00=No Outage 01=Outage
    feature_name: Rear_LED_Turn_Outage_Cfg
    target_state: No Outage
    bit: 3
    action: 0
  - nibble: 5
    community_instruction: 00=No Outage 01=Outage
    feature_name: Rear_LED_Turn_Outage_Cfg (RLEDTOC)
    target_state: RLEDTOC NO_OUTAGE
    bit: 3
    action: 0
