title: Rear Turn Signal Bulb Outage Detection
raw_community_title: Rear Turn Bulb Outage Detection (2021-2023)
category: Lighting
platform: F-150
model_years: 2021-2023
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: 00=No Outage (Target setting) 01=Outage. Set to No Outage if changing to LED
steps:
- module: BCM
  address: 726-44-02
  notes: 00=No Outage 01=Outage - set to no outage when upgrading to LED
  targets:
  - mask: '*xxx xxxx xx--'
    type: discrete
    community_hex: '0'
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: Rear_Bulb_Turn_Outage_Cfg (RBTOC)
      aliases:
      - Rear_Bulb_Turn_Outage_Cfg
      target_state: RBTOC NO_OUTAGE
      state_aliases:
      - No Outage
recipe_version: '1.1'
