    target_state: Disabled
    bit: 3
    action: 0
  - nibble: 9
    recommended_hex: '0'
    community_instruction: tricks Auto Start/Stop into thinking a steering event is
      happening at a stop so ASS never happens
    feature_name: Start / Stop
    target_state: Disabled
    bit: 3
    action: 0
- module: HVAC
  address: 733-01-05
  mask: xxxx x*xx xx--
  nibble: 5
