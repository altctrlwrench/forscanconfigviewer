title: AM Radio Tuner Enable
raw_community_title: ⚡ [Lightning] AM Radio Tuner Enable
category: Sync and Infotainment
platform: F-150 Lightning
model_years: '2023'
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Sync and Infotainment] [Years: 2023] [Original Title: Enable AM
  radio (2023 only)]

  Restores AM radio functionality and Sync audio source toggle. May disable satellite
  radio'
steps:
- module: ACM
  address: 727-01-02
  targets:
  - mask: xxxx x*xx xx--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: AM Tuner (AMT)
      target_state: AMT Enabled
- module: APIM
  address: 7D0-01-01
  targets:
  - mask: xxxx x*xx xx--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: SDARS Radio Present (SDARSRP)
      aliases:
      - X40 Radio Present (XRP)
      target_state: SDARSRP Non-SDARS Radio or Disabled
recipe_version: '1.1'
