title: Keyfob Panic Button Activation Mode
raw_community_title: Keyfob Panic Button
category: Locks and Security
platform: Bronco
model_years: 2021+
trim: All
source_sheet: 2021+ Bronco Common Items.xlsx
notes: '0=disabled, 1=2 clicks, 2=one click (default)

  Confirmed: nottinbe/multi'
steps:
- module: BdyCM
  address: 726-62-01
  notes: 0=disabled, 1=2 clicks, 2=one click (default)
  targets:
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: PanicActivate_Cfg (PAC)
      aliases:
      - PanicActivate_Cfg
      target_state: PAC DISABLE
      state_aliases:
      - Disable
    - bit: 0
      action: 1
      feature_name: PanicActivate_Cfg (PAC)
      aliases:
      - PanicActivate_Cfg
      target_state: PAC DOUBLE
      state_aliases:
      - Double
recipe_version: '1.1'
