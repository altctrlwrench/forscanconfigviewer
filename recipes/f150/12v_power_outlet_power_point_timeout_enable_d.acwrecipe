title: 12V Power Outlet (Power Point) Timeout Enable/Disable
raw_community_title: Power Point Timeout Configuration (2021-2026)
category: Convenience and Electrical
platform: F-150
model_years: 2021-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
steps:
- module: BCM
  address: 726-57-01
  mask: xxxx **xx xx--
  nibbles:
  - nibble: 4
    recommended_hex: '0'
    community_instruction: disabled (always on)
    feature_name: Power_Point_Timeout_Cfg
    target_state: Disable
    bit: 3
    action: 0
  - nibble: 5
    recommended_hex: '0'
    community_instruction: disabled (always on)
    feature_name: Power_Point_Timeout_Cfg (PPTC)
    target_state: PPTC DISABLE
    bit: 3
    action: 0
