    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
      feature: Feat_Cfg [SILENTMODE] [PERS_3] (SILENTMODE_PERS_3)
  - mask: xxxx xx*x xx--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 0
  - mask: xxxx xxx* xx--
    community_hex: '1'
