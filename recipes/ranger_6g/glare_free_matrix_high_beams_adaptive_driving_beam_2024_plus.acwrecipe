title: Glare-Free Matrix High Beams (Adaptive Driving Beam)
raw_community_title: Glare-Free/Matrix High Beams
category: Lighting
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'GFHB is Fords term for Matrix Headlights.  Disables the high beam in sections
  to allow it to darken (low beam) where cars are present and high beams where cars
  are not present.

  FORScan Menu: Multiple settings, use asbuilt (advanced)'
steps:
- module: IPMA
  address: 706-01-01
  notes: '* -> 9=GFHB, 5=OEM (Default)

    FORScan Menu: Multiple settings, use asbuilt (advanced)

    Trim: Lariat/Raptor [Confirmed: moproblems (12/31/24)]'
  targets:
  - mask: xxxx xxx* xx--
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: ModuleFeatureCfg_HighBeam (MFCHB)
      target_state: MFCHB GFHB
    - bit: 2
      action: 0
      feature_name: ModuleFeatureCfg_HighBeam (MFCHB)
      target_state: MFCHB GFHB
- module: SCCM
  address: 724-04-01
  notes: '* -> 3=GFHB, 2=OEM (Default)

    Trim: Lariat/Raptor [Confirmed: moproblems (12/31/24)]'
  targets:
  - mask: xxx* xxxx xx--
    type: discrete
    bits:
    - bit: 2
      action: 0
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF GFHB
    - bit: 1
      action: 1
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF GFHB
    - bit: 0
      action: 1
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF GFHB
- module: IPC
  address: 720-10-01
  notes: '* -> 2=GFHB, 1=OEM (Default)

    Trim: Lariat/Raptor [Confirmed: moproblems (12/31/24)]'
  targets:
  - mask: xxxx xxx* xx--
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: AutoHighBeam Menu (AHBM)
      target_state: AHBM Glarefree High Beams
    - bit: 0
      action: 0
      feature_name: AutoHighBeam Menu (AHBM)
      target_state: AHBM Glarefree High Beams
- module: HCM
  address: 734-01-02
  notes: '* -> 2=GFHB, 1=OEM (Default)

    Trim: Lariat/Raptor [Confirmed: moproblems (12/31/24)]'
  targets:
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: High_Beam_Handling_Config (HBHC)
      target_state: HBHC Adaptive Driving Beam
    - bit: 0
      action: 0
      feature_name: High_Beam_Handling_Config (HBHC)
      target_state: HBHC Adaptive Driving Beam
- module: HCM
  address: 734-01-04
  notes: '* -> A0-D1=GFHB, 11-1E=OEM (Default)

    FORScan Value: Select according to trim level

    Trim: Raptor Only [Confirmed: moproblems (12/31/24)]'
  targets:
  - mask: xx*x xxxx xx--
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
    - bit: 2
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 1
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
    - bit: 0
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
  - mask: xxx* xxxx xx--
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
  - mask: xxxx *xxx xx--
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
    - bit: 2
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
    - bit: 1
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 0
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Disabled
    - bit: 0
      action: 1
      feature_name: Glare-Free Matrix High Beams (Adaptive Driving Beam)
      target_state: Enabled
