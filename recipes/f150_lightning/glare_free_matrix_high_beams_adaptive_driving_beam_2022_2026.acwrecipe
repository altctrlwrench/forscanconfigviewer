title: Glare-Free Matrix High Beams (Adaptive Driving Beam)
raw_community_title: ⚡ [Lightning] Glare-Free High Beams (Matrix LED Enable)
category: Lighting
platform: F-150 Lightning
model_years: 2022-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: '[Category: Lighting] [Years: 2022-2026] [Original Title: Glare-free headlights]

  Enhances Auto High Beam behavior to provide localized dimming of brights based on
  surrounding traffic. Dynamic bending lights continue to work. May take a couple
  of restarts to take effect. Specific to Lightnings. Ensure no checksum DTCs are
  set for the HCM.'
steps:
- module: APIM
  address: 7D0-09-01
  targets:
  - mask: x*xx xxxx xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: Auto High Beam Control Function (AHBCF)
      target_state: AHBCF Disabled
- module: APIM
  address: 7D0-09-03
  targets:
  - mask: xx*x xxxx xx--
    community_hex: C
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Auto High Beam Menu (AHBM)
      target_state: AHBM Adaptive Driving Beams
    - bit: 2
      action: 1
      feature_name: Auto High Beam Menu (AHBM)
      target_state: AHBM Adaptive Driving Beams
- module: IPMA
  address: 706-01-01
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '9'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: ModuleFeatureCfg_HighBeam (MFCHB)
      target_state: MFCHB GFHB
      state_aliases:
      - MFCHB GFHB
    - bit: 2
      action: 0
      feature_name: ModuleFeatureCfg_HighBeam (MFCHB)
      target_state: MFCHB GFHB
- module: SCCM
  address: 724-04-01
  targets:
  - mask: xxx* xxxx xx--
    community_hex: '4'
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF ADB
    - bit: 1
      action: 0
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF ADB
    - bit: 0
      action: 0
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF ADB
- module: IPC
  address: 720-01-01
  targets:
  - mask: xx*x xxxx xx--
    community_hex: '8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Adaptive Head Lamps Control Function (AHLCF)
      target_state: AHLCF enabled
- module: IPC
  address: 720-10-01
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '3'
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: AutoHighBeam Menu (AHBM)
      target_state: AHBM Adaptive Driving Beams
    - bit: 0
      action: 1
      feature_name: AutoHighBeam Menu (AHBM)
      target_state: AHBM Adaptive Driving Beams
- module: HCM
  address: 734-01-02
  targets:
  - mask: xxxx x*xx xx--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: Config_AhbFeature (CAF)
      target_state: CAF ADB_GfHB
    - bit: 0
      action: 0
      feature_name: Config_AhbFeature (CAF)
      target_state: CAF ADB_GfHB
- module: HCM
  address: 734-03-02
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: m2_Zone_Lighting (ZL)
      target_state: ZL Enable
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: m2_ADB_DBL_combine (ADBDBL)
      target_state: ADBDBL ADB/DBL Combined
- module: HCM
  address: 734-11-01
  notes: Calibration strategy data block (0735 89--)
  targets:
  - mask: '*xxx xxxx xx--'
    community_hex: '0'
    type: discrete
  - mask: x*xx xxxx xx--
    community_hex: '7'
    type: discrete
  - mask: xx*x xxxx xx--
    community_hex: '3'
    type: discrete
  - mask: xxx* xxxx xx--
    community_hex: '5'
    type: discrete
  - mask: xxxx *xxx xx--
    community_hex: '8'
    type: discrete
  - mask: xxxx x*xx xx--
    community_hex: '9'
    type: discrete
recipe_version: '1.1'
