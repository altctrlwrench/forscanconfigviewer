title: Remote Engine Start Enable (Manual Transmission)
raw_community_title: Remote Start - 7-Speed
category: Convenience and Electrical
platform: Bronco
model_years: 2021+
trim: All
source_sheet: 2021+ Bronco Common Items.xlsx
notes: 'Remote Start via Keyfob

  Confirmed: Buck Your Bronco

  Remote Start Enable

  Confirmed: Buck Your Bronco

  Remote Start Lightning Enable

  Confirmed: Buck Your Bronco

  Two-way Remote Keyless Entry Enable

  Confirmed: Buck Your Bronco

  Remote Start feature Enable

  Confirmed: Buck Your Bronco'
steps:
- module: IPC
  address: 720-02-02
  notes: Remote Start via Keyfob
  targets:
  - mask: xxxx *xxx xx--
    community_hex: F
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Remote Start - Climate Settings (RSCS)
      aliases:
      - '*Remote Start - Climate Settings (RSCS)'
      target_state: RSCS enabled
    - bit: 2
      action: 1
      feature_name: Remote Start - Driver Seat (RSDS)
      aliases:
      - '*Remote Start - Driver Seat (RSDS)'
      target_state: RSDS enabled
    - bit: 1
      action: 1
      feature_name: Remote Start - Feature (RSF)
      aliases:
      - '*Remote Start - Feature (RSF)'
      target_state: RSF enabled
    - bit: 0
      action: 1
      feature_name: Remote Start - Passenger Seat (RSPS)
      aliases:
      - '*Remote Start - Passenger Seat (RSPS)'
      target_state: RSPS enabled
- module: BCM
  address: 726-30-01
  notes: Remote Start Enable
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Remote_Start_Enable_Cfg (RSEC)
      aliases:
      - Remote_Start_Enable_Cfg
      target_state: RSEC ENABLED
      state_aliases:
      - Enable
- module: BCM
  address: 726-63-02
  notes: Remote Start Lightning Enable
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: RStart_Lighting_Enable_Cfg (RSLEC)
      aliases:
      - RStart_Lighting_Enable_Cfg
      target_state: RSLEC ENABLE
      state_aliases:
      - Enable
- module: BCM
  address: 726-66-01
  notes: Two-way Remote Keyless Entry Enable
  targets:
  - mask: xxxx xxx* xx--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: TwoWayRKE_Enable_Cfg (TWRKEEC)
      aliases:
      - TwoWayRKE_Enable_Cfg
      target_state: TWRKEEC ENABLE
      state_aliases:
      - Enable
- module: APIM
  address: 7D0-09-01
  notes: Remote Start feature Enable
  targets:
  - mask: xxxx xxxx *x--
    community_hex: F
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Remote Start Climate Settings (RSCS)
      target_state: RSCS Enabled
    - bit: 2
      action: 1
      feature_name: Remote Start Driver Seat (RSDS)
      target_state: RSDS Enabled
    - bit: 1
      action: 1
      feature_name: Remote Start - Feature (RSF)
      aliases:
      - Remote Start - Climate Settings (RSCS) & Remote Start - Driver Seat (RSDS)
        &  Remote Start - Feature (RSF) & Remote Start - Passenger Seat (RSPS)
      target_state: RSF Enabled
      state_aliases:
      - RSCS disabled, RSDS disabled, RSF enabled, RSPS disabled
      - RSF enabled
    - bit: 0
      action: 1
      feature_name: Remote Start Passenger Seat (RSPS)
      target_state: RSPS Enabled
recipe_version: '1.1'
