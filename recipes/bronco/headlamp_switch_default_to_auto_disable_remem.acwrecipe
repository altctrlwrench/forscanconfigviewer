title: Headlamp Switch Default to Auto Disable (Remember Last Position)
raw_community_title: Auto Headlight
category: Lighting
platform: Bronco
model_years: 2021-2024
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2022 Bronco.xlsx
steps:
- module: BDYCM
  address: 726-74-01
  mask: xx** xxxx xx--
  nibbles:
  - nibble: 2
    community_instruction: 'HeadlampPosAtIgnOn_Cfg: 00=Auto 01=Last Known'
    feature_name: BSI_OpenDTC_Cfg (BSIODTCC)
    target_state: BSIODTCC NOT_USED
    bit: 3
    action: 0
  - nibble: 3
    community_instruction: 'HeadlampPosAtIgnOn_Cfg: 00=Auto 01=Last Known'
    feature_name: HeadlampPosAtIgnOn_Cfg (HPAIOC)
    target_state: HPAIOC AUTO
    bit: 3
    action: 0
