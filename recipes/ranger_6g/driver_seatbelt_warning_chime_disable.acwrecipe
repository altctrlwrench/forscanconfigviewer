title: Driver Seatbelt Warning Chime Disable
raw_community_title: Disables chime for Driver seatbelt
category: Chimes and Horn
platform: Ranger (6G)
model_years: 2024+
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: (2024+) 6G Ranger.xlsx
forscan_menu: Belt Minder Chime - Row 1 Col 1 (Set to Disabled. Also can be done using
  procedure in user manual)
steps:
- module: IPC
  address: 720-13-01
  mask: '*xxx xxxx xx--'
  nibble: 0
  hex_offset: '-1'
  community_instruction: subtract 1 to disable, e.g. change F to E)
  feature_name: R1C1 Belt Minder Chime (RCBMC)
  target_state: RCBMC Disabled
  bit: 0
  action: 0
