title: 360 & Bed Camera Display at Speed
raw_community_title: Enable Cameras at Speed
category: Cameras and ADAS
platform: F-150
model_years: 2021-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
steps:
- module: IPMA
  address: 706-02-02
  mask: xxx* **xx xx--
  nibbles:
  - nibble: 3
    recommended_hex: F
    feature_name: FeatureCfg_DPAC_ViewCtlAtSpeed_Hitch (FCDPACVCASH)
    target_state: FCDPACVCASH Enabled
    bit: 3
    action: 1
  - nibble: 4
    recommended_hex: C
    feature_name: FeatureCfg_TBA_HitchView (FCTBAHV)
    target_state: FCTBAHV Enabled
    bit: 3
    action: 1
  - nibble: 5
    recommended_hex: E
    feature_name: FeatureCfg_DPAC_ViewCtlAtSpeed (FCDPACVCAS)
    target_state: FCDPACVCAS Enabled
    bit: 1
    action: 1
- module: APIM
  address: 7D0-01-01
  mask: xxxx xxxx **--
  type: continuous
  instruction: ''
- module: APIM
  address: 7D0-01-04
  mask: xxxx **xx xx--
  nibbles:
  - nibble: 4
    recommended_hex: F
    community_instruction: use FF if you have 1-pedal drive
    feature_name: RCOD View (RCODV)
    target_state: RCODV Enabled
    bit: 3
    action: 1
  - nibble: 5
    recommended_hex: D
    community_instruction: use FF if you have 1-pedal drive
    feature_name: RCOD View at Speed (RCODVS)
    target_state: RCODVS Enabled
    bit: 3
    action: 1
