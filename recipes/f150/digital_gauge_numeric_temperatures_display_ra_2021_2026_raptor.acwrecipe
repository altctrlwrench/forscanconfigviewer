title: Digital Gauge Numeric Temperatures Display (Raptor Cluster)
raw_community_title: Raptor Cluster - displays engine, oil, transmission digital temps
  on top gauges
category: Cluster and Displays
platform: F-150
model_years: 2021-2026
trim: Raptor
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
steps:
- module: IPC
  address: 720-07-01
  mask: xxxx xx** xx--
  nibbles:
  - nibble: 6
    recommended_hex: '5'
    bits:
    - bit: 3
      action: 0
      feature_name: Eng Temp Dig (ETD)
      target_state: ETD Always Off
    - bit: 2
      action: 1
      feature_name: Eng Temp Dig (ETD)
      target_state: ETD Always On
    - bit: 1
      action: 0
      feature_name: Trans Temp Dig (TTD)
      target_state: TTD Always Off
    - bit: 0
      action: 1
      feature_name: Trans Temp Dig (TTD)
      target_state: TTD Always On
  - nibble: 7
    recommended_hex: '4'
    bits:
    - bit: 3
      action: 0
      feature_name: Eng Oil Dig (EOD)
      target_state: EOD Always Off
    - bit: 2
      action: 1
      feature_name: Eng Oil Dig (EOD)
      target_state: EOD Always On
validation_status: validated
unsupported_platforms:
- F-150 Lightning
warnings: Raptor gas engine transmission and coolant temperature display.
