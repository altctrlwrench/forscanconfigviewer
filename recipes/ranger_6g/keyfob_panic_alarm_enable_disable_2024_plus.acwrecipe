title: Keyfob Panic Alarm Enable/Disable
raw_community_title: Keyfob Panic Alarm
category: Locks and Security
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'FORScan Menu: Panic Alarm Mode (Lights and Horn or Lights only (target))

  Trim: All? [Confirmed: craigc (9/10/2024) Lariat FX4]'
steps:
- module: BCM
  address: 726-01-02
  notes: '* -> 0=lights & horn (default) 1=lights only

    FORScan Menu: Panic Alarm Mode (Change Honk and Lights to Lights only)

    Trim: All? [Confirmed: craigc (9/10/2024) Lariat FX4]'
  targets:
  - mask: xxxx xxx* xx--
    type: discrete
    bits:
    - bit: 3
      action: 0
    - bit: 2
      action: 0
    - bit: 1
      action: 0
    - bit: 0
      action: 1
      feature: PanicAlarm_Cfg (PAC)
recipe_version: '1.1'
