title: Rear Turn Signal Bulb Outage Detection
raw_community_title: Rear Turn Bulb Outage Detection (2024-2026)
category: Lighting
platform: F-150
model_years: 2024-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: 0=No Outage (target setting) 01=Outage. Set to No Outage if changing to LED
steps:
- module: BCM
  address: 726-44-01
  notes: 0=No Outage 01=Outage - set to no outage when upgrading to LED
  targets:
  - mask: xxxx x*xx xx--
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: Rear_Bulb_Turn_Outage_Cfg (RBTOC)
      aliases:
      - LF_RF_PositionLampCkt_Usage_Cfg (LFRFPLCUC)
      - LF_RF_PositionLampCkt_Usage_Cfg
      target_state: RBTOC NO_OUTAGE
recipe_version: '1.1'
