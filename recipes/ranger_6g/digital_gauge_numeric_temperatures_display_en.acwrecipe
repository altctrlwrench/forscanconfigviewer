title: Digital Gauge Numeric Temperatures Display (Engine & Trans)
raw_community_title: Digital Engine and Transmission Temperature Gauges in 12" cluster
category: Cluster and Displays
platform: Ranger (6G)
model_years: 2024+
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: (2024+) 6G Ranger.xlsx
steps:
- module: IPC
  address: 720-07-01
  mask: xxxx xx*x xx--
  notes: Target value sets Engine and Transmission Temp display to On.  Subtract 1
    from target value to disable transmission temp only. Subtract 4 from target value
    to disable engine temp only.
  community_instruction: Target value sets Engine and Transmission Temp display to
    On.  Subtract 1 from target value to disable transmission temp only. Subtract
    4 from target value to disable engine temp only.
  nibbles:
  - nibble: 6
    bits:
    - bit: 3
      action: 0
      feature_name: Eng Temp Dig (ETD)
      target_state: ETD Always Off
    - bit: 2
      action: 1
      feature_name: Eng Temp Dig (ETD)
      target_state: ETD Always On
    - bit: 1
      action: 0
      feature_name: Trans Temp Dig (TTD)
      target_state: TTD Always Off
    - bit: 0
      action: 1
      feature_name: Trans Temp Dig (TTD)
      target_state: TTD Always On
    hex_offset: '-1'
    notes: Target value sets Engine and Transmission Temp display to On.  Subtract
      1 from target value to disable transmission temp only. Subtract 4 from target
      value to disable engine temp only.
