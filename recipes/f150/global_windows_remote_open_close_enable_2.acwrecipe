title: Global Windows Remote Open/Close Enable
raw_community_title: "(2024-2026)  Global Windows Open/Close \n(driver/pass windows\
  \ only)"
category: Windows and Mirrors
platform: F-150
model_years: 2024-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
steps:
- module: DDM
  address: 740-06-02
  mask: xxxx xxx* **--
  type: continuous
  instruction: 'Optional: to add Global Open/Close to Sync 4 Settings menu set this
    in APIM: 7D0-09-01- xxxx xExx xx--'''
- module: PDM
  address: 741-06-02
  mask: xxxx xxx* **--
  type: continuous
  instruction: 'Optional: to add Global Open/Close to Sync 4 Settings menu set this
    in APIM: 7D0-09-01- xxxx xExx xx--'''
- module: BCM
  address: 726-11-02
  mask: x*xx x*xx xx--
  nibbles:
  - nibble: 1
    recommended_hex: '1'
    community_instruction: To roll down windows press unlock button on fob and then
      press again and hold
    feature_name: GlobalClose_Cfg (GCC)
    target_state: GCC DISABLE
    bit: 3
    action: 0
  - nibble: 5
    recommended_hex: '1'
    community_instruction: To roll down windows press unlock button on fob and then
      press again and hold
    feature_name: GlobalOpen_Cfg (GOC)
    target_state: GOC DISABLE
    bit: 3
    action: 0
- module: BCM
  address: 726-22-01
  mask: xxxx xxxx **--
  type: continuous
  instruction: 'Optional: to add Global Open/Close to Sync 4 Settings menu set this
    in APIM: 7D0-09-01- xxxx xExx xx--'''
- module: BCM
  address: 726-22-02
  mask: xxxx xxxx **--
  type: continuous
  instruction: 'Optional: to add Global Open/Close to Sync 4 Settings menu set this
    in APIM: 7D0-09-01- xxxx xExx xx--'''
