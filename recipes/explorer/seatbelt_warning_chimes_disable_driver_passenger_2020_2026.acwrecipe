title: Seatbelt Warning Chimes Disable (Driver & Passenger)
raw_community_title: Disable Driver and Passenger seatbelt reminder (2020-2024 only)
category: General
platform: F-150
model_years: 2020-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: disables constant driver and passenger seatbelt reminder (beeping while in
  drive)
steps:
- module: IPC
  address: 720-01-01
  notes: disables constant driver and passenger seatbelt reminder (beeping while in
    drive)
  targets:
  - mask: xxxx xx*x xx--
    type: discrete
    bits:
    - bit: 2
      action: 0
      feature_name: '*Driver Beltminder (DB)'
      aliases:
      - Driver Beltminder (DB)
      target_state: DB disabled
    - bit: 1
      action: 0
      feature_name: '*Pass BeltMinder (PBM)'
      aliases:
      - Pass BeltMinder (PBM)
      target_state: PBM disabled
    - bit: 0
      action: 0
      feature_name: '*Mid Pass Beltminder (MPB)'
      aliases:
      - Mid Pass Beltminder (MPB)
      target_state: MPB disabled
recipe_version: '1.1'
