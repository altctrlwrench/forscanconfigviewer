title: Trailer Side View Camera on Turn Signal
raw_community_title: Trailer Side View - shows corresponding camera view alongside
  of vehicle when turn signal is applied with trailer connected
category: General
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: "Shows corresponding camera view alongside of vehicle when turn signal is applied\
  \ with trailer connected\nShows left or right blind spot on center screen when turn\
  \ signal is used. \nCan be configured to only work for one side\nFORScan Menu: unknown,\
  \ use asbuilt (advanced) (Not available - use asbuilt)\nConfirmed: craigc (10/4/2024)\
  \ Lariat\n* -> Bit 4 (add 8 to enable.  e.g. change 5 to D)\nFORScan Menu: Turn\
  \ Signal Views (Disabled (Default), Enabled)"
steps:
- module: IPMA
  address: 706-01-02
  notes: "* -> Bits 1 and 2 (add 3 to enable both right and left.  e.g. change 0 to\
    \ 3)  \nIf only left camera is desired, instead of adding 3, add 1, and if only\
    \ right camera is desired, add 2\nFORScan Menu: unknown, use asbuilt (advanced)\
    \ (Not available - use asbuilt)\nConfirmed: craigc (10/4/2024) Lariat"
  targets:
  - mask: '*xxx xxxx xx--'
    type: discrete
    bits:
    - bit: 1
      action: 1
      feature_name: ModuleFeatureCfg_TurnSgnlView (MFCTSV)
      target_state: MFCTSV Right
    - bit: 0
      action: 1
      feature_name: ModuleFeatureCfg_TurnSgnlView (MFCTSV)
      target_state: MFCTSV Left
- module: APIM
  address: 7D0-02-03
  notes: '* -> Bit 4 (add 8 to enable.  e.g. change 5 to D)

    FORScan Menu: Turn Signal Views (Disabled (Default), Enabled)'
  targets:
  - mask: xxxx x*xx xx--
    offset_hint: '+8'
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Turn Signal Views (TSV)
      target_state: TSV Present
recipe_version: '1.1'
