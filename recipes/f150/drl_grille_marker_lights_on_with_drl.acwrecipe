steps:
- module: BCM
  address: 726-38-01
  mask: xxxx xxxx **--
  nibbles:
  - nibble: 8
    recommended_hex: '0'
    community_instruction: Daytime Running Lights (DRL) Include Parklamps Config
    feature_name: DRL_IncludeParklamps_Cfg
    target_state: Disable
    bit: 3
    action: 0
  - nibble: 9
    recommended_hex: '1'
    community_instruction: Daytime Running Lights (DRL) Include Parklamps Config
    feature_name: DRL_IncludeParklamps_Cfg (DRLIPC)
    target_state: DRLIPC DISABLE
    bit: 3
    action: 0
- module: BCM
  address: 726-43-02
  mask: xxxx xx** xx--
  type: continuous
  feature_name: OutageABM_Cfg
  instruction: Daytime Running Lights (DRL) Include Parklamps Config
- module: BCM
  address: 726-87-01
  mask: xx** xxxx xx--
