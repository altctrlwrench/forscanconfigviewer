title: Tire Pressure Monitoring System (TPMS) Enable/Disable
raw_community_title: TPMS
category: Cluster and Displays
platform: Super Duty
model_years: 2023-2026
trim: All
source_sheet: 2023-2026 Super Duty Common Items.xlsx
notes: 'TPMS 0=Disabled  1=Enabled

  TPMS  Front/Rear Tire pressure converted to hex'
steps:
- module: BdyCm-BCM
  address: 726-10-01
  notes: TPMS 0=Disabled  1=Enabled
  targets:
  - mask: xxx* xxxx xx--
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: TPMEnable_Cfg (TPMEC)
      aliases:
      - TPMEnable_Cfg
      target_state: TPMEC DISABLE
      state_aliases:
      - Disable
recipe_version: '1.1'
