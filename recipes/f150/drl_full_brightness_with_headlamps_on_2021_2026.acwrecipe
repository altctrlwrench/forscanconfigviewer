title: DRL - Full Brightness with Headlamps On
raw_community_title: DRLs - full brightness (2021-2026)
category: Lighting
platform: F-150
model_years: 2021-2026
trim: All
source_sheet: 2021-2026 F150.xlsx
notes: To change brightness for last two nibbles set at about 60% (3C hex) thru 75%
  (4B hex) use lowest value you can before flickering appears
steps:
- module: BCM
  address: 726-42-01
  targets:
  - mask: x*xx xxxx xx--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 2
      action: 0
      feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
      aliases:
      - LF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: LFDRLLCUC NOT_USED
      state_aliases:
      - Not Used
    - bit: 1
      action: 1
      feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
      aliases:
      - LF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: LFDRLLCUC DRL_POSITION
      state_aliases:
      - DRL Position
    - bit: 0
      action: 0
      feature_name: LF_DRL_Lamp_Ckt_Usage_Cfg (LFDRLLCUC)
      aliases:
      - LF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: LFDRLLCUC NOT_USED
      state_aliases:
      - Not Used
  - mask: xxx* xxxx xx--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 2
      action: 0
      feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
      aliases:
      - RF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: RFDRLLCUC NOT_USED
      state_aliases:
      - Not Used
    - bit: 1
      action: 1
      feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
      aliases:
      - RF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: RFDRLLCUC DRL_POSITION
      state_aliases:
      - DRL Position
    - bit: 0
      action: 0
      feature_name: RF_DRL_Lamp_Ckt_Usage_Cfg (RFDRLLCUC)
      aliases:
      - RF_DRL_Lamp_Ckt_Usage_Cfg
      target_state: RFDRLLCUC NOT_USED
      state_aliases:
      - Not Used
- module: BCM
  address: 726-38-01
  notes: set at about 60% (3C hex) thru 75% (4B hex) use lowest value you can before
    flickering appears
  targets:
  - mask: xxxx **xx xx--
    type: continuous
    user_input: required
recipe_version: '1.1'
