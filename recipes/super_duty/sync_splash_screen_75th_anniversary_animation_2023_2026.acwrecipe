title: Sync Splash Screen - 75th Anniversary Animation
raw_community_title: Enable 75th Anniversary Splash Screen
category: Sync and Infotainment
platform: Super Duty
model_years: 2023-2026
trim: All
source_sheet: 2023-2026 Super Duty Common Items.xlsx
notes: 'No options set for webpage. Set to 24 for 75th.

  Multiple options such as default, presidential (05), black label (04), Europe (0A),
  etc. (check sheet for values)'
steps:
- module: APIM
  address: 7D0-03-01
  targets:
  - mask: xxxx *xxx xx--
    community_hex: '2'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 2
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 1
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS F150
      state_aliases:
      - SS Continental
      - SS S650 Dark Horse Welcome Animation (w/ B&O)
      - SS Unused
    - bit: 0
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
  - mask: xxxx x*xx xx--
    community_hex: '4'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 2
      action: 1
      feature_name: Splash Screen (SS)
      target_state: SS Black Label
      state_aliases:
      - SS Continental
      - SS S650 Pony Welcome Animation (w/ B&O)
      - SS Unused
    - bit: 1
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
    - bit: 0
      action: 0
      feature_name: Splash Screen (SS)
      target_state: SS Default/not programmed
recipe_version: '1.1'
