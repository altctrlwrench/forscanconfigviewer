title: BlueCruise / Traffic Jam Assist Mode Selection
raw_community_title: 'ADAS - Advanced Driver Assist Systems

  Disable BlueCruise and enable Traffic Jam Assist

  (settings for normal Adaptive Cruise Control) (2021-2026)'
category: Cameras and ADAS
platform: F-150
model_years: 2021-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2021-2026 F150.xlsx
notes: enables Traffic Jam Assist & disables Highway Assist
steps:
- module: IPMA
  address: 706-01-01
  mask: xxx* xxxx *x--
  notes: enables Traffic Jam Assist & disables Highway Assist
  nibbles:
  - nibble: 3
    recommended_hex: '8'
    notes: enables Traffic Jam Assist & disables Highway Assist
    feature_name: ModuleFeatureCfg_TJA (MFCTJA)
    target_state: MFCTJA Enabled
    bit: 3
    action: 1
  - nibble: 8
    recommended_hex: '8'
    notes: enables Traffic Jam Assist & disables Highway Assist
    feature_name: ModuleFeatureCfg_HwyAssist (MFCHA)
    target_state: MFCHA Disabled
    bit: 1
    action: 0
validation_status: validated
