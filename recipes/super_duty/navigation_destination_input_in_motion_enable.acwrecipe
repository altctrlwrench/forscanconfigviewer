title: Navigation Destination Input in Motion Enable
raw_community_title: Navigation in Motion
category: Sync and Infotainment
platform: Super Duty
model_years: 2023-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2023 Super Duty.xlsx
notes: Breaks Sync Voice - KIP programing option screen
warnings: Disables Sync Voice input while vehicle is in motion.
steps:
- module: APIM
  address: 7D0-03-01
  mask: '**** xxxx xx--'
  notes: Breaks Sync Voice - KIP programing option screen
  nibbles:
  - nibble: 0
    recommended_hex: '5'
    notes: Breaks Sync Voice - KIP programing option screen
    bits:
    - bit: 3
      action: 0
      feature_name: First Letter of Country Code (FLCC)
    - bit: 2
      action: 1
      feature_name: First Letter of Country Code (FLCC)
    - bit: 1
      action: 0
      feature_name: First Letter of Country Code (FLCC)
    - bit: 0
      action: 1
      feature_name: First Letter of Country Code (FLCC)
  - nibble: 1
    recommended_hex: '7'
    notes: Breaks Sync Voice - KIP programing option screen
    bits:
    - bit: 3
      action: 0
      feature_name: First Letter of Country Code (FLCC)
    - bit: 2
      action: 1
      feature_name: First Letter of Country Code (FLCC)
    - bit: 1
      action: 1
      feature_name: First Letter of Country Code (FLCC)
    - bit: 0
      action: 1
      feature_name: First Letter of Country Code (FLCC)
  - nibble: 2
    recommended_hex: '5'
    notes: Breaks Sync Voice - KIP programing option screen
    bits:
    - bit: 3
      action: 0
      feature_name: Second Letter of Country Code (SLCC)
    - bit: 2
      action: 1
      feature_name: Second Letter of Country Code (SLCC)
    - bit: 1
      action: 0
      feature_name: Second Letter of Country Code (SLCC)
    - bit: 0
      action: 1
      feature_name: Second Letter of Country Code (SLCC)
  - nibble: 3
    recommended_hex: '3'
    notes: Breaks Sync Voice - KIP programing option screen
    bits:
    - bit: 3
      action: 0
      feature_name: Second Letter of Country Code (SLCC)
    - bit: 2
      action: 0
      feature_name: Second Letter of Country Code (SLCC)
    - bit: 1
      action: 1
      feature_name: Second Letter of Country Code (SLCC)
    - bit: 0
