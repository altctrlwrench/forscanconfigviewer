title: Auto Start/Stop Cluster Notification Disable
raw_community_title: Disable Auto Stop Start Feature (only affects cluster visibility/nag)
category: Cluster and Displays
platform: Ranger (6G)
model_years: 2024+
trim: All
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'FORScan Menu: Auto Stop Start (Enabled (Default), Disabled (target))

  Confirmed: craigc (10/13/2024) Lariat

  sloon (10/13/2024) Raptor'
steps:
- module: IPC
  address: 720-01-01
  notes: '* -> Bit2 (Subtract 2 to disable.  e.g. change 3 to 1)

    FORScan Menu: Auto Stop Start (Enabled (Default), Disabled)

    Confirmed: craigc (10/13/2024) Lariat

    sloon (10/13/2024) Raptor'
  targets:
  - mask: xxxx *xxx xx--
    type: discrete
    bits:
    - bit: 1
      action: 0
      feature_name: Auto Stop Start (ASS)
      target_state: ASS disabled
recipe_version: '1.1'
