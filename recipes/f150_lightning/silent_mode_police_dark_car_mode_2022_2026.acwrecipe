title: Silent Mode / Police Dark Car Mode
raw_community_title: Enable Silent Mode (AKA campground / dark mode)
category: Lighting
platform: F-150 Lightning
model_years: 2022-2026
trim: All
validated: true
verified_by: Kyle / AsBuiltPro & Lightning Community
source_sheet: F-150 Lightning FORScan Thread
notes: Creates a SYNC toggle to turn on/off Silent Mode. Silent Mode turns off cluster
  lighting, welcome lighting, courtesy lights, and SYNC screen when opening doors;
  also silences the horn when locking doors.
steps:
- module: BCM
  address: 726-25-02
  mask: '**** **** **--'
  nibbles:
  - nibble: 0
    recommended_hex: '0'
    community_instruction: Set to 0
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [SILENTMODE] [PERS_1] (SILENTMODE_PERS_1)
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Feat_Cfg [SILENTMODE] [PERS_1] (SILENTMODE_PERS_1)
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Feat_Cfg [SILENTMODE] [PERS_1] (SILENTMODE_PERS_1)
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: Feat_Cfg [SILENTMODE] [PERS_1] (SILENTMODE_PERS_1)
      target_state: Disabled
  - nibble: 1
    recommended_hex: '1'
    community_instruction: Set to 1
    bits:
    - bit: 3
      action: 0
      feature_name: Feat_Cfg [SILENTMODE] [PERS_1] (SILENTMODE_PERS_1)
      target_state: Disabled
    - bit: 2
