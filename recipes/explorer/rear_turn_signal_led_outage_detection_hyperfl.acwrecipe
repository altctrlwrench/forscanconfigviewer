title: Rear Turn Signal LED Outage Detection (Hyperflash Disable)
raw_community_title: Rear Turn LED Outage Detection (2021-2024)
category: Lighting
platform: Explorer
model_years: 2021-2024
trim: All
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: 2020-2024 Explorer.xlsx
steps:
- module: BCM
  address: 726-40-02
  mask: xxxx **xx xx--
  nibbles:
  - nibble: 4
    recommended_hex: '0'
    community_instruction: 00=No Outage 01=Outage
    feature_name: Front_Bulb_Turn_Outage_Cfg (FBTOC)
    target_state: FBTOC NO_OUTAGE
    bit: 3
    action: 0
  - nibble: 5
    recommended_hex: '0'
    community_instruction: 00=No Outage 01=Outage
    feature_name: Rear_LED_Turn_Outage_Cfg (RLEDTOC)
    target_state: RLEDTOC NO_OUTAGE
    bit: 3
    action: 0
