title: Global Windows Remote Open/Close Enable
raw_community_title: Global Open/Close
category: Windows and Mirrors
platform: Super Duty
model_years: 2023-2026
trim: All
source_sheet: 2023-2026 Super Duty Common Items.xlsx
steps:
- module: APIM
  address: 7D0-09-01
  targets:
  - mask: xxxx x*xx xx--
    community_hex: E
    type: discrete
    bits:
    - bit: 3
      action: 1
      feature_name: Global Window Open (GWO)
      aliases:
      - Global Window Open (GWO) & Global Window Close (GWC) &  Daytime Running Lamps
        Control Function (DRLCF) & Temporary Mobility Kit (TMK)
      target_state: GWO Enabled
      state_aliases:
      - GWO enabled, GWC disabled, DRLCF disabled, TMK disabled
      - GWO enabled
- module: DDM
  address: 740-06-02
  targets:
  - mask: xxxx xxxx *x--
    community_hex: '0'
    type: discrete
    bits:
    - bit: 3
      action: 0
      feature_name: Global Windows Remote Open/Close Enable
      target_state: Disabled
    - bit: 2
      action: 0
      feature_name: Global Windows Remote Open/Close Enable
      target_state: Disabled
    - bit: 1
      action: 0
      feature_name: Global Windows Remote Open/Close Enable
      target_state: Disabled
    - bit: 0
      action: 0
      feature_name: Global Windows Remote Open/Close Enable
      target_state: Disabled
  - mask: xxxx xxxx x*--
    community_hex: '1'
    type: discrete
    bits:
    - bit: 0
      action: 1
      feature_name: Global_Open_Cfg (GOC)
      target_state: GOC ENABLED
