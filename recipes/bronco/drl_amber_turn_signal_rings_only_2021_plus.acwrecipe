title: DRL - Amber Turn Signal Rings Only
raw_community_title: Daytime running lights - after writting vehicle must be in drive
  to see new state (doesn't work in park)
category: Lighting
platform: Bronco
model_years: 2021+
trim: All
source_sheet: 2021+ Bronco Common Items.xlsx
notes: '** NOTE 04 works during daylight, at night white and blink amber

  Confirmed: D2dhanover|multi'
steps:
- module: BdyCM
  address: 726-43-01
  notes: 'LF_DRL_Lamp_Ckt_Usage_Cfg:

    00=Not Used 01=DRL Only 02=DRL Position 03=Fixed DRL Position 04=Turn and DRL
    05=Position Only 06=Stop Turn

    ** NOTE 04 works during daylight, at night white and blink amber'
  targets:
  - mask: '*xxx xxxx xx--'
    type: discrete
    community_hex: '0'
  - mask: x*xx xxxx xx--
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature_name: LF_Turn_Lamp_Ckt_Usage_Cfg (LFTLCUC)
      aliases:
      - LF_Turn_Lamp_Ckt_Usage_Cfg
      target_state: LFTLCUC TURN_POSITION_DRL
      state_aliases:
      - Turn Position DRL
    - bit: 1
      action: 0
      feature_name: LF_Turn_Lamp_Ckt_Usage_Cfg (LFTLCUC)
      aliases:
      - LF_Turn_Lamp_Ckt_Usage_Cfg
      target_state: LFTLCUC TURN_POSITION_DRL
      state_aliases:
      - Not Used
    - bit: 0
      action: 0
      feature_name: LF_Turn_Lamp_Ckt_Usage_Cfg (LFTLCUC)
      aliases:
      - LF_Turn_Lamp_Ckt_Usage_Cfg
      target_state: LFTLCUC TURN_POSITION_DRL
      state_aliases:
      - Not Used
- module: BdyCM
  address: 726-43-01
  notes: 'RF_DRL_Lamp_Ckt_Usage_Cfg

    00=Not Used 01=DRL Only 02=DRL Position 03=Fixed DRL Position 04=Turn and DRL
    05=Position Only 06=Stop Turn

    ** NOTE 04 works during daylight, at night white and blink amber'
  targets:
  - mask: xx*x xxxx xx--
    type: discrete
    community_hex: '0'
  - mask: xxx* xxxx xx--
    type: discrete
    bits:
    - bit: 2
      action: 1
      feature_name: RF_Turn_Lamp_Ckt_Usage_Cfg (RFTLCUC)
      aliases:
      - RF_Turn_Lamp_Ckt_Usage_Cfg
      target_state: RFTLCUC TURN_POSITION_DRL
      state_aliases:
      - Turn Position DRL
    - bit: 1
      action: 0
      feature_name: RF_Turn_Lamp_Ckt_Usage_Cfg (RFTLCUC)
      aliases:
      - RF_Turn_Lamp_Ckt_Usage_Cfg
      target_state: RFTLCUC TURN_POSITION_DRL
      state_aliases:
      - Not Used
    - bit: 0
      action: 0
      feature_name: RF_Turn_Lamp_Ckt_Usage_Cfg (RFTLCUC)
      aliases:
      - RF_Turn_Lamp_Ckt_Usage_Cfg
      target_state: RFTLCUC TURN_POSITION_DRL
      state_aliases:
      - Not Used
recipe_version: '1.1'
