title: Glare-Free Matrix High Beams (Adaptive Driving Beam)
raw_community_title: Glare-Free/Matrix High Beams
category: Lighting
platform: Ranger (6G)
model_years: 2024+
trim: Lariat / Raptor
validated: true
verified_by: Kyle / AsBuiltPro
source_sheet: (2024+) 6G Ranger.xlsx
notes: 'GFHB is Fords term for Matrix Headlights.  Disables the high beam in sections
  to allow it to darken (low beam) where cars are present and high beams where cars
  are not present.

  FORScan Menu: Multiple settings, use asbuilt (advanced)'
forscan_menu: Multiple settings, use asbuilt (advanced)
steps:
- module: IPMA
  address: 706-01-01
  mask: xxxx xxx* xx--
  notes: 9=GFHB, 5=OEM (Default)
  nibbles:
  - nibble: 7
    bits:
    - bit: 3
      action: 1
      feature_name: ModuleFeatureCfg_HighBeam (MFCHB)
      target_state: MFCHB GFHB
    - bit: 2
      action: 0
      feature_name: ModuleFeatureCfg_HighBeam (MFCHB)
      target_state: MFCHB Disabled
    notes: 9=GFHB, 5=OEM (Default)
- module: SCCM
  address: 724-04-01
  mask: xxx* xxxx --
  notes: 3=GFHB, 2=OEM (Default)
  nibbles:
  - nibble: 3
    bits:
    - bit: 3
      action: 0
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF Undefined
    - bit: 2
      action: 0
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF Undefined
    - bit: 1
      action: 1
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF GFHB
    - bit: 0
      action: 1
      feature_name: AHB_Feature (AHBF)
      target_state: AHBF GFHB
    notes: 3=GFHB, 2=OEM (Default)
- module: IPC
  address: 720-10-01
  mask: xxxx xxx* xx--
  notes: 2=GFHB (target), 1=Auto High Beam (Default)
  nibbles:
  - nibble: 7
    bits:
    - bit: 1
      action: 1
      feature_name: AutoHighBeam Menu (AHBM)
      target_state: AHBM Glarefree High Beams
    - bit: 0
      action: 0
      feature_name: AutoHighBeam Menu (AHBM)
      target_state: AHBM Disabled
    notes: 2=GFHB (target), 1=Auto High Beam (Default)
- module: HCM
  address: 734-01-02
  mask: x*xx xxxx xx--
  notes: 2=GFHB, 1=OEM (Default), 3=With Dynamic Bending Combined Hardware (untested)
    | Option not available
  nibbles:
  - nibble: 1
    bits:
    - bit: 3
      action: 0
      feature_name: High_Beam_Handling_Config (HBHC)
      target_state: HBHC OFF
    - bit: 2
      action: 0
      feature_name: High_Beam_Handling_Config (HBHC)
      target_state: HBHC OFF
    - bit: 1
      action: 1
      feature_name: High_Beam_Handling_Config (HBHC)
      target_state: HBHC Adaptive Driving Beam
    - bit: 0
      action: 0
      feature_name: High_Beam_Handling_Config (HBHC)
      target_state: HBHC OFF
    notes: 2=GFHB, 1=OEM (Default), 3=With Dynamic Bending Combined Hardware (untested)
      | Option not available
- module: HCM
  address: 734-01-04
  mask: xx** **--
  notes: '* -> A0-D1=GFHB, 11-1E=OEM (Default)

    FORScan Value: Select according to trim level

    Trim: Raptor Only [Confirmed: moproblems (12/31/24)]'
  nibbles:
  - nibble: 2
    notes: '**RAPTOR VALUES ONLY!


      A0-D1=GFHB, 11-1E=OEM (Default)

      FORScan Value: Select according to trim level

      Trim: Raptor Only [Confirmed: moproblems (12/31/24)]'
    bits:
    - bit: 3
      action: 1
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 2
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 1
      action: 1
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 0
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
  - nibble: 3
    notes: '**RAPTOR VALUES ONLY!


      A0-D1=GFHB, 11-1E=OEM (Default)

      FORScan Value: Select according to trim level

      Trim: Raptor Only [Confirmed: moproblems (12/31/24)]'
    bits:
    - bit: 3
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 2
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 1
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 0
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
  - nibble: 4
    notes: '**RAPTOR VALUES ONLY!


      A0-D1=GFHB, 11-1E=OEM (Default)

      FORScan Value: Select according to trim level

      Trim: Raptor Only [Confirmed: moproblems (12/31/24)]'
    bits:
    - bit: 3
      action: 1
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
    - bit: 2
      action: 1
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
    - bit: 1
      action: 0
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
    - bit: 0
      action: 1
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
  - nibble: 5
    notes: '**RAPTOR VALUES ONLY!


      A0-D1=GFHB, 11-1E=OEM (Default)

      FORScan Value: Select according to trim level

      Trim: Raptor Only [Confirmed: moproblems (12/31/24)]'
    bits:
    - bit: 3
      action: 0
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
    - bit: 2
      action: 0
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
    - bit: 1
      action: 0
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
    - bit: 0
      action: 1
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
- module: HCM
  address: 734-01-04
  mask: xx** **--
  notes: '* -> A5-4E=GFHB, 14-81=OEM (Default)

    Trim: Lariat Only [Confirmed: Waffel (01/06/25)]'
  nibbles:
  - nibble: 2
    notes: '**LARIAT VALUES ONLY!


      A5-4E=GFHB, 14-81=OEM (Default)

      Trim: Lariat Only [Confirmed: Waffel (01/06/25)]'
    bits:
    - bit: 3
      action: 1
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 2
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 1
      action: 1
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 0
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
  - nibble: 3
    notes: '**LARIAT VALUES ONLY!


      A5-4E=GFHB, 14-81=OEM (Default)

      Trim: Lariat Only [Confirmed: Waffel (01/06/25)]'
    bits:
    - bit: 3
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 2
      action: 1
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 1
      action: 0
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
    - bit: 0
      action: 1
      feature_name: CRC_HIGH_BYTE (CRCHIGHBYTE)
  - nibble: 4
    notes: '**LARIAT VALUES ONLY!


      A5-4E=GFHB, 14-81=OEM (Default)

      Trim: Lariat Only [Confirmed: Waffel (01/06/25)]'
    bits:
    - bit: 3
      action: 0
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
    - bit: 2
      action: 1
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
    - bit: 1
      action: 0
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
    - bit: 0
      action: 0
      feature_name: CRC_LOW_BYTE (CRCLOWBYTE)
  - nibble: 5
    notes: '**LARIAT VALUES ONLY!


      A5-4E=GFHB, 14-81=OEM (Default)

      Trim: Lariat Only [Confirmed: Waffel (01/06/25)]'
    bits:
    - bit: 3
      action: 1
