title: Front Turn Signal LED Outage Detection (Hyperflash Disable)
raw_community_title: Front Turn LED Outage Detection
category: Lighting
platform: Super Duty
model_years: 2023-2026
trim: All
source_sheet: 2023-2026 Super Duty Common Items.xlsx
notes: 0=No Outage 1=Outage
steps:
- module: BdyCm-BCM
  address: 726-40-02
  notes: 0=No Outage 1=Outage
  targets:
  - mask: xxx* xxxx xx--
    type: discrete
    bits:
    - bit: 0
      action: 0
      feature_name: Front_LED_Turn_Outage_Cfg (FLEDTOC)
      aliases:
      - Front_LED_Turn_Outage_Cfg
      target_state: FLEDTOC NO_OUTAGE
      state_aliases:
      - No Outage
